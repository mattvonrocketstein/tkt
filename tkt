  // the menu icons in groups, left to right: tickets, wiki, actions, view, site, with a thin rule between groups. entries
  // are matched by their labels; one not listed, such as a menu entry added under Admin, joins the wiki group.
  // the ul becomes a flex row in dom order, so without this script the icons keep their floated order
  function menuGroups(){
    var ul=document.querySelector('.mainmenu ul'); if(!ul) return;
    var G=[['New Ticket','Reports'],['New Wiki Page','Project Wiki'],['Add Action','Project Actions'],['Zoom out','Zoom in','Page Reload','Toggle dark mode'],['GitHub','Fossil Site Map','Login']];
    var lis=[].slice.call(ul.children), groups=G.map(function(){ return []; });
    lis.forEach(function(li){
      var a=li.querySelector('a'), l=a&&a.getAttribute('aria-label')||'', g=1;
      G.forEach(function(names,i){ names.forEach(function(n){ if(l.indexOf(n)===0) g=i; }); });
      groups[g].push({li:li,rank:G[g].indexOf(G[g].filter(function(n){ return l.indexOf(n)===0; })[0])});
    });
    ul.classList.add('tkt-grouped');
    groups.filter(function(g){ return g.length; }).forEach(function(g,i){
      g.sort(function(x,y){ return (x.rank<0?99:x.rank)-(y.rank<0?99:y.rank); });
      if(i){ var sep=document.createElement('li'); sep.className='tkt-menusep'; sep.setAttribute('aria-hidden','true'); ul.appendChild(sep); }
      g.forEach(function(x){ ul.appendChild(x.li); });
    });
  }
  // report pages: the table and its filter bar go into a card titled with the report name, with the ticket view's card controls.
  // rows are uncolored, so a color key (fossil's own reports still have one) is dropped
  var ICON='<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  var CLIP='<path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"/>';
  function ago(d){
    var s=Math.round((Date.now()-d)/1000), u=[['year',31536000],['month',2592000],['week',604800],['day',86400],['hour',3600],['minute',60]];
    if(s<60) return 'just now';
    for(var i=0;i<u.length;i++){ var n=Math.floor(s/u[i][1]); if(n>=1) return n+' '+u[i][0]+(n>1?'s':'')+' ago'; }
  }
  // a card built in the page, for content fossil renders itself: the same label, collapse and copy controls as the
  // template's cards. returns the card and its empty body
  function makeCard(cls,title){
    var card=document.createElement('div'), label=document.createElement('div'), body=document.createElement('div'), ctl=document.createElement('span');
    card.className='tkt-card '+cls; label.className='tkt-card-label'; body.className='tkt-card-body'; ctl.className='tkt-card-ctl';
    ctl.innerHTML='<a href="#" class="tkt-fold" aria-label="Collapse">'+ICON+' class="tkt-fold-up"><path d="M6 15l6 -6l6 6"/></svg>'+ICON+' class="tkt-fold-down"><path d="M6 9l6 6l6 -6"/></svg></a>'
      +'<a href="#" class="tkt-copy" aria-label="Copy contents">'+ICON+' class="tkt-clip">'+CLIP+'</svg>'+ICON+' class="tkt-clipped">'+CLIP+'<path d="M9 14l2 2l4 -4"/></svg></a>';
    label.appendChild(ctl); label.appendChild(document.createTextNode(title));
    card.appendChild(label); card.appendChild(body);
    return {card:card,body:body};
  }
  // fossil appends an 'Attachments:' heading and list after the ticket view. it becomes a card after the description:
  // each file links to its artifact, then who added it and when, then a download icon
  function attachCard(){
    if(!document.querySelector('.tkt-card-fields')) return;
    var h=[].filter.call(document.querySelectorAll('h2'),function(e){ return e.textContent.trim()==='Attachments:'; })[0]; if(!h) return;
    var ul=h.nextElementSibling; if(!ul||ul.tagName!=='UL') return;
    var c=makeCard('tkt-card-attach','Attachments');
    [].forEach.call(ul.children,function(li){
      var name=li.querySelector('a[href*="/artifact/"]'), dl=li.querySelector('a[href*="/attachdownload/"]'), when=li.querySelector('a[href*="timeline?c="]');
      if(!name) return;
      var who=(li.textContent.match(/added by (\S+) on/)||[])[1], s=when&&when.textContent.trim(), row=document.createElement('div');
      row.className='tkt-attach'; row.appendChild(name);
      var meta=document.createElement('span'); meta.className='tkt-card-meta';
      if(who) meta.appendChild(document.createTextNode(who+(s?' · ':'')));
      if(s){ var t=document.createElement('span'); t.className='tkt-ago'; t.setAttribute('data-utc',s); t.setAttribute('aria-label',s+' UTC'); t.textContent=s; meta.appendChild(t); }
      row.appendChild(meta);
      if(dl){ dl.className='tkt-inlineicon'; dl.setAttribute('aria-label','Download'); dl.innerHTML=ICON+'><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/><path d="M7 11l5 5l5 -5"/><path d="M12 4l0 12"/></svg>'; row.appendChild(dl); }
      c.body.appendChild(row);
    });
    var cards=document.querySelectorAll('.tkt-card'), after=document.querySelector('.tkt-card-desc')||cards[1]||cards[0];
    after.parentNode.insertBefore(c.card,after.nextSibling);
    ul.remove(); h.remove();
  }
  // after the ticket title, small icons that jump to its comments and its attachments, each with its count as the hint.
  // a section the ticket does not have gets no icon; it runs after the title's capitalization, which rewrites its text
  function jumpLinks(){
    var tt=document.getElementById('ticket-title'); if(!tt) return;
    var cm=document.querySelectorAll('.tkt-card-comment'), at=document.querySelector('.tkt-card-attach'), parts=[];
    function n(k,w){ return k+' '+w+(k===1?'':'s'); }
    if(cm.length){ cm[0].id='comments'; parts.push(['#comments','Jump to '+n(cm.length,'comment'),'<path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/>']); }
    if(at){ at.id='attachments'; parts.push(['#attachments','Jump to '+n(at.querySelectorAll('.tkt-attach').length,'attachment'),'<path d="M15 7l-6.5 6.5a1.5 1.5 0 0 0 3 3l6.5 -6.5a3 3 0 0 0 -6 -6l-6.5 6.5a4.5 4.5 0 0 0 9 9l6.5 -6.5"/>']); }
    if(!parts.length) return;
    var s=document.createElement('small'); s.className='tkt-jumps';
    // fossil pages carry a base href, so the jump links spell out this page's path
    s.innerHTML=parts.map(function(p){ return '<span class="tkt-jump-sep">|</span><a href="'+location.pathname+location.search+p[0]+'" aria-label="'+p[1]+'">'+ICON+'>'+p[2]+'</svg></a>'; }).join('');
    tt.appendChild(s);
  }
  function reportCard(){
    if(!/\/rptview/.test(location.pathname)) return;
    var t=document.querySelector('table.report.sortable')||document.querySelector('table.report thead')&&document.querySelector('table.report thead').parentNode; if(!t) return;
    var key=[].filter.call(document.querySelectorAll('table.report'),function(k){ return k!==t&&!k.tHead; })[0];
    var bar=t.previousElementSibling&&t.previousElementSibling.classList.contains('tkt-filterbar')?t.previousElementSibling:null;
    var c=makeCard('tkt-card-report',document.title.replace(/^[^:]*:\s*/,'')), body=c.body;
    if(key) key.remove();
    [].forEach.call(t.querySelectorAll('tbody tr[style]'),function(r){ r.style.backgroundColor=''; });
    t.parentNode.insertBefore(c.card,bar||t);
    if(bar) body.appendChild(bar);
    body.appendChild(t);
    // timestamp columns read as '3 days ago'. fossil's sort compares cell text, so the utc timestamp stays first in the cell,
    // hidden, and the exact time is the hover hint
    var heads=[].map.call(t.tHead?t.tHead.rows[0].cells:[],function(h){ return h.textContent.trim().toLowerCase(); });
    heads.forEach(function(h,i){
      // sizes read as '1.2 KB'; the byte count stays first in the cell, hidden and zero-padded, so the column sorts by size
      if(h==='size'){
        [].forEach.call(t.tBodies[0].rows,function(r){
          var c=r.cells[i], b=c&&parseInt(c.textContent,10); if(!c||isNaN(b)) return;
          c.innerHTML='<span hidden>'+('000000000'+b).slice(-10)+'</span>'+(b<1024?b+' B':(b/1024).toFixed(1)+' KB');
        });
        return;
      }
      if(h!=='mtime'&&h!=='closed'&&h!=='created') return;
      [].forEach.call(t.tBodies[0].rows,function(r){
        var c=r.cells[i], s=c&&c.textContent.trim(), d=s&&new Date(s.replace(' ','T')+'Z'); if(!d||isNaN(d)) return;
        c.innerHTML='<span hidden>'+s+'</span><span class="tkt-ago" aria-label="'+s+' UTC">'+ago(d)+'</span>';
      });
    });
    // in a report that mixes open and closed tickets, a closed ticket's row is dimmed and its id and title struck through
    var si=heads.indexOf('status');
    if(si>=0) [].forEach.call(t.tBodies[0].rows,function(r){
      if(!r.cells[si]||r.cells[si].textContent.trim()!=='Closed') return;
      r.classList.add('tkt-closedrow');
      ['#','title'].forEach(function(k){ var i=heads.indexOf(k); if(i>=0&&r.cells[i]) r.cells[i].classList.add('tkt-closed'); });
    });
    // column headers in title case. the sql names stay lowercase, since fossil links a column named '#' and the facet filter
    // matches on the lowercase names, which it read before this runs
    var NAMES={'#':'Ticket','mtime':'Updated'};
    [].forEach.call(t.tHead?t.tHead.rows[0].cells:[],function(h){
      var n=h.firstChild; if(!n||n.nodeType!==3||!n.nodeValue.trim()) return;
      var v=n.nodeValue.trim();
      n.nodeValue=NAMES[v]||v.replace(/\b\w/g,function(c){ return c.toUpperCase(); });
    });
    // each row's trailing 'edit' link becomes the tabler edit icon, followed by a copy icon for the ticket id
    [].forEach.call(t.querySelectorAll('tbody a[href*="tktedit/"]'),function(a){
      if(a.textContent.trim()!=='edit') return;
      a.className='tkt-rowedit'; a.setAttribute('aria-label','Edit');
      a.innerHTML=ICON+'><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"/><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"/><path d="M16 5l3 3"/></svg>';
      var id=(a.getAttribute('href').match(/tktedit\/([0-9a-f]+)/)||[])[1]; if(!id) return;
      var c=document.createElement('a'); c.href='#'; c.className='tkt-rowedit tkt-copy'; c.setAttribute('data-id',id.slice(0,10)); c.setAttribute('aria-label','Copy ticket id');
      c.innerHTML=ICON+' class="tkt-clip">'+CLIP+'</svg>'+ICON+' class="tkt-clipped">'+CLIP+'<path d="M9 14l2 2l4 -4"/></svg>';
      a.parentNode.style.whiteSpace='nowrap'; a.parentNode.appendChild(c);
    });
  }
  // the ticket view's actions all live on the page itself, so its submenu is hidden; so is any submenu whose links are all hidden
  function bareSubmenu(){
    var m=document.querySelector('.submenu'); if(!m) return;
    // the wiki list keeps fossil's new-page link (the ticket copy is hidden in css), named for what it makes
    var wn=document.body.classList.contains('cpage-wcontent')&&m.querySelector('a.sml-new');
    if(wn){ wn.textContent='New Page'; wn.classList.add('tkt-wikinew'); }
    // the wiki pages report stands in for fossil's page list, so it carries that list's new-page link too
    if(/\/rptview/.test(location.pathname)&&/^Wiki Pages$/.test(document.title.replace(/^[^:]*:\s*/,''))&&!m.querySelector('a.tkt-wikinew')){
      var np=document.createElement('a'); np.className='label tkt-wikinew'; np.textContent='New Page';
      np.href=location.pathname.replace(/\/rptview$/,'/wikinew'); m.appendChild(np);
    }
    // a wiki page's submenu leads back to the page list
    if(document.body.classList.contains('cpage-wiki')&&!m.querySelector('a.tkt-wikiall')){
      var all=document.createElement('a'); all.className='label tkt-wikiall'; all.textContent='All Pages';
      all.href=(m.querySelector('a.sml-help')||{href:'/wikihelp'}).href.replace(/\/(wikihelp|wiki\?.*)$/,'/rptview?title=Wiki+Pages');
      m.insertBefore(all,m.firstChild);
    }
    // fossil's wiki help knows nothing of tkt's diagrams and highlighting, so Help goes to tkt's formatting guide, which links back to it
    [].forEach.call(m.querySelectorAll('a[href$="/wikihelp"]'),function(h){ h.href=h.href.replace(/\/wikihelp$/,'/wiki?name=agents/FormattingHelp'); });
    var shown=[].some.call(m.children,function(c){ return getComputedStyle(c).display!=='none'; });
    if(document.querySelector('.tkt-card-fields')||!shown) m.classList.add('tkt-bare');
