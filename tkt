mapping_template() {
  cat <<'EOF'
# Mapping

> **Template.** This page has not been filled in yet. Follow [Agent Home](/wiki?name=agents/Home) and each
> *Instructions* block below, then delete this note and the *Instructions* blocks. Keep the
> *Conventions* section: it governs every later edit to this page.

## Conventions

- **Working notes, not a reference.** This is the raw map of what has been found while exploring the code. It may be
  messy, partial, and wrong. [System Diagrams](/wiki?name=templates/SystemDiagrams) is the curated picture; this page
  is where material for it is gathered.
- **Discovered, not designed.** Record what the code actually contains, as found, with the path or command that
  shows it. No conceptual or planned parts.
- **Mark confidence.** Tag each claim *confirmed* (read or ran it), *likely* (inferred from names or partial reading),
  or *guess*. Upgrade the tag when you check it.
- **Append freely, prune carefully.** Add findings as you go. Delete a finding only when it is shown wrong, or once it
  has been promoted, and leave a line saying where it went.
- **Promote what settles.** When part of the map stops changing, move it into System Diagrams,
  [Lexicon](/wiki?name=templates/Lexicon), or [Workflows](/wiki?name=templates/Workflows), and link to it from here.
- **Crude diagrams are fine.** A rough mermaid sketch, even a large one, beats none; tidy it when it is promoted.

## Folders and files

*Instructions:* the directory tree as far as it has been explored, one line per folder or notable file on what it
appears to hold, with a confidence tag. Note generated, vendored, and dead-looking code. A trimmed `tree` or
`ls` listing in a `text` fence is a fine start.

## Entry points

*Instructions:* every way execution starts that you have found (binaries, scripts, `main` functions, routes, jobs,
hooks, tests), with path and confidence.

## Symbols

*Instructions:* the types, functions, tables, config keys, and constants that keep coming up, one row each,
with where they are defined and a confidence tag.

| Symbol | Kind | Defined at | What it seems to do |
| --- | --- | --- | --- |
| `example` | function | `src/example.py:42` | *likely:* one line |

## Useful commands

*Instructions:* commands that helped explore: searches that find things (`grep`/`rg` patterns, `git log -S`),
introspection and debug flags, ways to dump state, queries against local data. Each with one line on what it
shows. Everyday build and test commands belong on Workflows; move a command there once it becomes routine.

## Dependencies

*Instructions:* external services, libraries that shape the design, and internal modules that everything imports.
Which parts depend on which, as found.

## Sketches

*Instructions:* rough diagrams made while exploring, newest first, each with a date and the question it was
answering.

## Unknowns

*Instructions:* what is still unexplored or unexplained: directories not yet read, code whose purpose is unclear,
contradictions between findings. Remove an entry when it is answered and record the answer above.
EOF
}

# pages the project owns once seeded, each with the function that writes it: init creates a missing one and never
# touches it again. agents/Home tells agents it is tkt's and not theirs to edit, but humans may tailor it per project
SEED_ONCE='agents/Home:agent_home templates/SystemDiagrams:system_diagrams_template templates/Lexicon:lexicon_template templates/Style:style_template templates/Workflows:workflows_template templates/Mapping:mapping_template'

seed_templates() {
  local f t
  f=$(mktemp)
  for t in $SEED_ONCE; do
    fx wiki export "${t%%:*}" >/dev/null 2>&1 && continue
    "${t##*:}" >"$f"
    fx wiki create "${t%%:*}" "$f" --mimetype text/x-markdown >/dev/null
  done
  rm -f "$f"
}

verb_init() {
  command -v fossil >/dev/null || die 'fossil not found; see https://fossil-scm.org for install instructions'
  local tmp adopt=
  case "$1" in
    '') ;;
    --adopt) adopt=1 ;;
    *) die "unexpected argument: $1 (only --adopt)" ;;
  esac
  if [ ! -f "$REPO" ]; then
    fossil init --admin-user "${TKT_USER:-${USER:-fossil}}" --project-name "$(basename "$(dirname "$REPO")")" "$REPO" >&2
  elif [ -z "$adopt" ] && ! owned "$REPO"; then
    die "$REPO is not a tkt tracker; init would replace its ticket schema, ticket view, and main menu, and give anonymous users read access. Rerun with --adopt to do that anyway"
  fi
  # best effort: whatever goes wrong here, init carries on and pages fall back to the cdn
  ( store_assets ) || note "page scripts: storing them failed; pages load them from cdnjs"
  tmp=$(mktemp -d)
  schema >"$tmp/schema"
  common >"$tmp/common"
  view >"$tmp/view"
  newpage >"$tmp/new"
  editpage >"$tmp/edit"
  skin_css >"$tmp/css"
  skin_header "$(github_url || true)" >"$tmp/header"
  skin_footer >"$tmp/footer"
  skin_details >"$tmp/details"
  init_config
  old_actions_page
  reports >"$tmp/reports"
  sqlq "replace into config(name,value,mtime) values('ticket-table',cast(readfile('$tmp/schema') as text),strftime('%s','now'));" \
       "insert or ignore into config(name,value,mtime) values('ticket-common',cast(readfile('$tmp/common') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('ticket-viewpage',cast(readfile('$tmp/view') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('ticket-newpage',cast(readfile('$tmp/new') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('ticket-editpage',cast(readfile('$tmp/edit') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('mainmenu',$(lit "$MENU"),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('index-page','/ticket',strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('css',cast(readfile('$tmp/css') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('header',cast(readfile('$tmp/header') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('footer',cast(readfile('$tmp/footer') as text),strftime('%s','now'));" \
       "replace into config(name,value,mtime) values('details',cast(readfile('$tmp/details') as text),strftime('%s','now'));" \
       "delete from config where name='default-skin';" \
       "replace into config(name,value,mtime) values('default-csp',$(lit "$CSP"),strftime('%s','now'));" \
       ".read $tmp/reports" \
       "replace into config(name,value,mtime) values('tkt-version','$TKT_VERSION',strftime('%s','now'));"
  rm -rf "$tmp"
  fx user capabilities nobody "$GUEST" >/dev/null
  fx user capabilities anonymous "$GUEST" >/dev/null
  seed_owned "$GUIDE_PAGE" format_guide || note "formatting guide: seeding the wiki page failed"
  seed_templates || note "agent home and template pages: seeding them failed"
  fossil rebuild "$REPO" >/dev/null
  init_skill
  note "ready at $REPO"
}

verb_new() {
  need
  kv 'title type status severity priority subsystem tags foundin parent' "$@"
  [ -n "$kv_title" ] || die 'title is required'
  local body foundin parent=
  if [ -n "$kv_parent" ]; then parent=$(resolve "$kv_parent"); fit_parent '' "$parent"; fi
  body=$(slurp)
  foundin=${kv_foundin:-$(git rev-parse -q --verify HEAD 2>/dev/null || true)}
  safe "$kv_title" "$kv_type" "$kv_status" "$kv_severity" "$kv_priority" "$kv_subsystem" "$kv_tags" "$foundin" "$body"
  fx ticket add \
    title "$kv_title" \
    type "${kv_type:-Code_Defect}" \
    status "${kv_status:-Open}" \
    severity "${kv_severity:-Important}" \
    priority "${kv_priority:-Medium}" \
    subsystem "$kv_subsystem" \
    tags "$kv_tags" \
    parent "$parent" \
    foundin "$foundin" \
    mimetype text/x-markdown \
    description "$body"
}

verb_edit() {
  need
  local id body
  id=$(resolve "$1")
  body=$(slurp editor)
  [ -n "$body" ] || die 'nothing on stdin'
  safe "$body"
  fx ticket set "$id" description "$body" mimetype text/x-markdown
}

verb_comment() {
  need
  local id body
  id=$(resolve "$1")
  body=$(slurp editor)
  [ -n "$body" ] || die 'nothing on stdin'
  safe "$body"
  fx ticket set "$id" +icomment "$body" mimetype text/x-markdown
}

# fossil drops an empty field value, so clearing writes a space
verb_tag() {
  need
  local id tags
  id=$(resolve "$1")
  shift
  if [ "$1" = --clear ]; then
    tags=' '
  else
    if [ $# -gt 0 ]; then tags="$*"; else tags=$(slurp); fi
    tags=$(echo $tags)
    [ -n "$tags" ] || die 'no tags given; use --clear to empty the set'
  fi
  safe $tags
  fx ticket set "$id" tags "$tags"
}

verb_block() {
  need
  local id ids='' tok hit parent
  id=$(resolve "$1")
  shift
  parent=$(sqlq "select trim(coalesce(parent,'')) from ticket where tkt_uuid like '$id%';")
  if [ "$1" = --clear ]; then
    ids=' '
  else
    [ $# -gt 0 ] || set -- $(slurp)
    [ $# -gt 0 ] || die 'no ids given; use --clear to empty the set'
    for tok in "$@"; do
      hit=$(resolve "$tok")
      [ "$hit" != "$id" ] || die 'a ticket cannot block itself'
      [ "$hit" != "$parent" ] || die "$hit is the parent of $id, and a parent cannot block its subtask"
      ids="$ids $hit"
    done
    ids=${ids# }
  fi
  fx ticket set "$id" blockers "$ids"
}

# subtasks are one level deep: a parent has no parent, and a ticket with subtasks takes none
fit_parent() {
  local child=$1 parent=$2
  [ "$child" != "$parent" ] || die 'a ticket cannot be its own parent'
  [ "$(sqlq "select count(*) from ticket where tkt_uuid like '$parent%' and trim(coalesce(parent,'')) <> '';")" = 0 ] \
    || die "$parent is itself a subtask, and subtasks are one level deep"
  [ -z "$child" ] || [ "$(sqlq "select count(*) from ticket where trim(coalesce(parent,'')) = '$child';")" = 0 ] \
    || die "$child has subtasks of its own, and subtasks are one level deep"
  [ -z "$child" ] || [ "$(sqlq "select count(*) from ticket where tkt_uuid like '$child%' and ' ' || coalesce(blockers,'') || ' ' like '% $parent %';")" = 0 ] \
    || die "$parent blocks $child, and a parent cannot block its subtask; first run: tkt block $child --clear, or block on the rest"
}

verb_parent() {
  need
  local id parent
  id=$(resolve "$1")
  shift
  if [ "$1" = --clear ]; then
    parent=' '
  else
    [ $# -gt 0 ] || set -- $(slurp)
    [ $# -gt 0 ] || die 'no parent given; use --clear to remove it'
    [ $# -eq 1 ] || die 'a ticket has one parent'
    parent=$(resolve "$1")
    fit_parent "$id" "$parent"
  fi
  fx ticket set "$id" parent "$parent"
}

verb_set() {
  need
  local id field value have
  id=$(resolve "$1")
  field=$2
  [ -n "$field" ] || die 'usage: tkt set <id> <field> [value...]'
  shift 2
  case "$field" in
    icomment|+icomment|comment) die 'use: tkt comment' ;;
    description) die 'use: tkt edit' ;;
    tags) die 'use: tkt tag' ;;
    blockers) die 'use: tkt block' ;;
    parent) die 'use: tkt parent' ;;
  esac
  have=" $(sqlq "select group_concat(name,' ') from pragma_table_info('ticket');") "
  case "$have" in *" $field "*) ;; *) die "unknown field: $field" ;; esac
  if [ $# -gt 0 ]; then value="$*"; else value=$(slurp); fi
  [ -n "$value" ] || die 'no value given'
  safe "$value"
  fx ticket set "$id" "$field" "$value"
}

verb_close() {
  need
  local id body
  id=$(resolve "$1")
  shift
  kv resolution "$@"
  body=$(slurp)
  safe "$kv_resolution" "$body"
  fx ticket set "$id" status Closed resolution "${kv_resolution:-Fixed}"
  [ -z "$body" ] || fx ticket set "$id" +icomment "$body" mimetype text/x-markdown
  local open
  open=$(sqlq "select count(*) from ticket where trim(coalesce(parent,'')) = '$id' and status in ('Open','WIP');")
  [ "${open:-0}" = 0 ] || note "closed with $open open subtask(s); see: tkt show $id"
}

# purged artifacts go to fossil's graveyard, so a clean can be reverted with: tkt run purge undo <id>
verb_clean() {
  need
  local force= a hashes ans
  for a in "$@"; do
    case "$a" in
      -f|--force) force=1 ;;
      *) die 'usage: tkt clean [--force]' ;;
    esac
  done
  hashes=$(sqlq "select b.uuid from blob b join ticketchng c on c.tkt_rid=b.rid join ticket t on t.tkt_id=c.tkt_id where t.status='Closed';")
  [ -n "$hashes" ] || { note 'no closed tickets'; return; }
  sqlq "select $COLS from ticket where status='Closed' order by tkt_mtime desc;" | paint
  if [ -z "$force" ]; then
    [ -t 0 ] || die 'not a terminal; use: tkt clean --force'
    read -r -p 'purge these closed tickets? [y/N] ' ans || ans=
    case "$ans" in y|Y|yes|YES) ;; *) die 'aborted' ;; esac
  fi
  fx purge artifacts $hashes >/dev/null
  note 'purged; undo with: tkt run purge undo <id>, see: tkt run purge list'
}

verb_show() {
  need
  local id
  id=$(resolve "$1")
  local xb="'- ' || substr(b.tkt_uuid,1,10) || ' | ' || coalesce(nullif(b.status,''),'-') || ' | ' || coalesce(nullif(b.title,''),'(untitled)')"
  local xs="'- ' || substr(s.tkt_uuid,1,10) || ' | ' || coalesce(nullif(s.status,''),'-') || ' | ' || coalesce(nullif(s.title,''),'(untitled)')"
  sqlq \
    "select '# ' || coalesce(nullif(title,''),'(untitled)') || char(10) || char(10) || $COLS || char(10) || char(10) || coalesce(nullif(trim(description),''),'(no description)') || coalesce((select group_concat(char(10) || char(10) || '---' || char(10) || char(10) || c.icomment, '') from ticketchng c where c.tkt_id=ticket.tkt_id and coalesce(c.icomment,'')!=''),'') from ticket where tkt_uuid like '$id%';" \
    "select char(10) || '## Parent' || char(10) || char(10) || $xb from ticket t join ticket b on substr(b.tkt_uuid,1,10) = trim(t.parent) where t.tkt_uuid like '$id%';" \
    "select char(10) || '## Subtasks' || char(10) || char(10) || group_concat($xb, char(10)) from (select b.* from ticket t join ticket b on trim(b.parent) = substr(t.tkt_uuid,1,10) where t.tkt_uuid like '$id%' order by b.tkt_ctime) b having count(*) > 0;" \
    "select char(10) || '## Blocked by' || char(10) || char(10) || group_concat($xb, char(10)) from ticket t join ticket b on ' ' || coalesce(t.blockers,'') || ' ' like '% ' || substr(b.tkt_uuid,1,10) || ' %' where t.tkt_uuid like '$id%' having count(b.tkt_id) > 0;" \
    "select char(10) || '## Blocks' || char(10) || char(10) || group_concat($xb, char(10)) from ticket t join ticket b on ' ' || coalesce(b.blockers,'') || ' ' like '% ' || substr(t.tkt_uuid,1,10) || ' %' where t.tkt_uuid like '$id%' having count(b.tkt_id) > 0;" \
    "select char(10) || '## Referenced by' || char(10) || char(10) || group_concat(row, char(10)) from (select distinct $xs as row from ticket t join backlink bl on t.tkt_uuid like bl.target || '%' join ticketchng c on c.tkt_rid=bl.srcid join ticket s on s.tkt_id=c.tkt_id and s.tkt_id != t.tkt_id where bl.srctype=1 and t.tkt_uuid like '$id%') having count(*) > 0;" \
    | paint
}

verb_list() {
  need
  kv 'status tag parent' "$@"
  local want=${kv_status:-Open} filter
  case "$want" in
    all) filter='where 1=1' ;;
    Open) filter="where status in ('Open','WIP')" ;;
    *) filter="where status=$(lit "$want")" ;;
  esac
  [ -z "$kv_tag" ] || filter="$filter and ' '||coalesce(tags,'')||' ' like $(lit "% $kv_tag %")"
  [ -z "$kv_parent" ] || filter="$filter and trim(coalesce(parent,'')) = '$(resolve "$kv_parent")'"
  sqlq "select $COLS from ticket $filter order by tkt_mtime desc;" | paint
}

SEV_RANK="case severity when 'Critical' then 0 when 'Severe' then 1 when 'Important' then 2 when 'Minor' then 3 else 4 end"

# the newest open tickets: short id, title, severity, subsystem. --triage keeps only the top severity present
verb_todo() {
  need
  local n=10 triage= fmt=txt where sel q out
  while [ $# -gt 0 ]; do
    case "$1" in
      --triage) triage=1 ;;
      -f|--format) [ $# -gt 1 ] || die 'usage: tkt todo [N] [--triage] [-f txt|md|json]'; fmt=$2; shift ;;
      --format=*) fmt=${1#*=} ;;
      ''|*[!0123456789]*) die "usage: tkt todo [N] [--triage] [-f txt|md|json] (got: $1)" ;;
      *) n=$1 ;;
    esac
    shift
  done
  where="status in ('Open','WIP')"
  [ -z "$triage" ] || where="$where and $SEV_RANK = (select min($SEV_RANK) from ticket where status in ('Open','WIP'))"
  sel="substr(tkt_uuid,1,10) as id, coalesce(nullif(title,''),'(untitled)') as title, coalesce(nullif(severity,''),'-') as severity, coalesce(nullif(subsystem,''),'-') as subsystem"
  q="select $sel from ticket where $where order by tkt_mtime desc, tkt_id desc limit $n;"
  case "$fmt" in
    txt) printf '.mode list\n.headers off\n.separator " | "\n%s\n' "$q" | fossil sql -R "$REPO" | paint ;;
    md|markdown) printf '.mode markdown\n%s\n' "$q" | fossil sql -R "$REPO" ;;
    json) out=$(printf '.mode json\n%s\n' "$q" | fossil sql -R "$REPO"); printf '%s\n' "${out:-[]}" ;;
    *) die "unknown format: $fmt (known: txt md json)" ;;
  esac
}

verb_triage() { verb_todo --triage "$@"; }

verb_search() {
  need
  [ $# -gt 0 ] || die 'usage: tkt search <text>'
  local pat
  pat=$(lit "%$*%")
  sqlq "select $COLS from ticket where lower(coalesce(title,'') || ' ' || coalesce(description,'')) like lower($pat) or tkt_id in (select tkt_id from ticketchng where lower(coalesce(icomment,'')) like lower($pat)) order by tkt_mtime desc;" | paint
}

# TKT_PORT from a .env beside the tracker, for a project-local default under the environment; the file is read, never sourced
dotenv_port() {
  local f=$(dirname "$REPO")/.env line
  [ -f "$f" ] || return 0
  line=$(grep -E '^(export[[:space:]]+)?TKT_PORT=' "$f" | tail -n 1) || return 0
  line=${line#*=}
  line=${line%%[[:space:]]#*}
  line=${line%"${line##*[![:space:]]}"}
  case "$line" in \"*\") line=${line#\"}; line=${line%\"} ;; \'*\') line=${line#\'}; line=${line%\'} ;; esac
  printf '%s' "$line"
}

# something already listening on the port; this tracker's own server is stopped before this runs
busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# port= on the command line, else TKT_PORT in the environment, else TKT_PORT in .env beside the tracker, else 9080
port_of() {
  kv port "$@"
  local at=${kv_port:-${TKT_PORT:-$(dotenv_port)}}
  at=${at:-9080}
  case "$at" in ''|*[!0123456789]*) die "not a port: $at" ;; esac
  printf '%s' "$at"
}

# the pid file holds a pid and port, trusted only while that pid is still this tracker's fossil server
running() {
  local pid port
  [ -f "$REPO.pid" ] && read -r pid port <"$REPO.pid" || return 1
  case "$pid" in ''|*[!0123456789]*) return 1 ;; esac
  ps -p "$pid" -o command= 2>/dev/null | grep -qF -- "server $REPO" || return 1
  printf '%s %s' "$pid" "$port"
}

halt() {
  local pid port n=0
  read -r pid port <<<"$(running)"
  if [ -z "$pid" ]; then rm -f "$REPO.pid"; return 1; fi
  kill "$pid"
  while kill -0 "$pid" 2>/dev/null && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  rm -f "$REPO.pid"
  note "stopped the server on port $port (pid $pid)"
}

# refresh the header so the github links track the current origin remote
install_header() {
  local tmp
  tmp=$(mktemp)
  skin_header "$(github_url || true)" >"$tmp"
  sqlq "replace into config(name,value,mtime) values('header',cast(readfile('$tmp') as text),strftime('%s','now'));"
  rm -f "$tmp"
}

# hand a url to the platform's opener: $BROWSER first, then the system's own, then python's webbrowser module.
# quiet, and false when nothing works
launch() {
  local url=$1
  if [ -n "${BROWSER:-}" ]; then "$BROWSER" "$url" && return; fi
  case "$(uname -s)" in
    Darwin) open "$url" && return ;;
    MINGW*|MSYS*|CYGWIN*) start "" "$url" && return ;;
    *) if command -v xdg-open >/dev/null; then xdg-open "$url" && return
       elif command -v wslview >/dev/null; then wslview "$url" && return
       elif command -v powershell.exe >/dev/null; then powershell.exe -NoProfile -Command "Start-Process '$url'" && return; fi ;;
  esac
  local py
  for py in python3 python; do
    command -v "$py" >/dev/null || continue
    "$py" -m webbrowser -t "$url" && return
  done
  return 1
} >/dev/null 2>&1

# open the browser once the server answers, from a background job so the foreground exec can proceed.
# only on a terminal, since agents and scripts print the url instead; TKT_OPEN=0 turns it off
open_when_up() {
  local at=$1 url=$2 n=0
  [ -t 1 ] && [ "${TKT_OPEN:-1}" != 0 ] || return 0
  (
    while ! busy "$at"; do sleep 0.1; n=$((n + 1)); [ $n -lt 100 ] || exit 1; done
    launch "$url"
  ) </dev/null >/dev/null 2>&1 &
}

# this script's own absolute path, links resolved, for fossil to run as CGI
self_path() {
  local p=$0
  case "$p" in */*) ;; *) p=$(command -v "$p") ;; esac
  (cd "$(dirname "$p")" && printf '%s/%s' "$(pwd -P)" "$(basename "$p")")
}

# $REPO.ext holds only a link to this script: fossil's extroot, which runs it as CGI, and the first PATH entry of
# every job, so an action that runs plain `tkt`, such as an agent using the tkt skill, gets this one. under CGI
# self_path is that link, so it is resolved, or the link would point at itself
ext_link() {
  local me
  me=$(readlink -f "$(self_path)" 2>/dev/null || self_path)
  mkdir -p "$REPO.ext"
  [ "$(readlink "$REPO.ext/tkt" 2>/dev/null)" = "$me" ] || ln -sfn "$me" "$REPO.ext/tkt"
}

verb_serve() {
  need
  local at url
  at=$(port_of "$@")
  halt || true
  ! busy "$at" || die "port $at is taken, likely by another project's tkt serve; pass port=<n>, or set TKT_PORT in the environment or in $(dirname "$REPO")/.env"
  install_header
  printf '%s %s\n' "$$" "$at" >"$REPO.pid"
  url=http://localhost:$at/ticket
  printf '%s\n' "$url"
  note "serving $REPO in the foreground as pid $$; Ctrl-C or tkt stop ends it"
  open_when_up "$at" "$url"
  # fossil runs this script as CGI for /ext/tkt, which serves the project actions
  ext_link
  exec fossil server "$REPO" --port "$at" --localhost --localauth --extroot "$REPO.ext"
}

verb_stop() {
  halt || note "nothing serving $REPO"
}

verb_status() {
  local pid port
  read -r pid port <<<"$(running)"
  if [ -z "$pid" ]; then note "nothing serving $REPO"; return 1; fi
  printf 'http://localhost:%s/ticket\n' "$port"
  note "serving $REPO as pid $pid"
}

schema_notes() {
  cat <<'EOF'
tkt sql runs read-only: it can query the tracker but never change it.

ticket: one row per ticket, holding each field's current value
  tkt_uuid     the full id; tkt shows its first ten characters
  status       Open, WIP, or Closed
  tags         space-separated words
  blockers     space-separated ten-character ids of the tickets this one waits on
  parent       the ten-character id this ticket is a subtask of; one level deep
  description  the current problem statement, in markdown
  tkt_ctime, tkt_mtime   julian day numbers; datetime(tkt_mtime) gives a timestamp
  An emptied tags, blockers or parent field holds a single space, so test trim(tags) = ''.

ticketchng: one row per change to a ticket
  tkt_id       joins ticket.tkt_id
  icomment     the comment that change added, in markdown; empty when it added none
  login        who made the change

backlink: references written as [](<uuid>) in ticket text
  target       the referenced uuid or prefix
  srcid        joins ticketchng.tkt_rid, the change whose text holds the reference
  srctype      1 for ticket text

Open tickets whose blockers and subtasks are all closed:
  select substr(t.tkt_uuid,1,10) as id, t.title from ticket t
   where t.status in ('Open','WIP') and not exists (
     select 1 from ticket b
      where (' ' || coalesce(t.blockers,'') || ' ' like '% ' || substr(b.tkt_uuid,1,10) || ' %'
             or trim(coalesce(b.parent,'')) = substr(t.tkt_uuid,1,10))
        and b.status != 'Closed');

Open tickets untouched for 30 days:
  select substr(tkt_uuid,1,10) as id, title, date(tkt_mtime) as touched from ticket
   where status != 'Closed' and tkt_mtime < julianday('now','-30 days');

Columns:
EOF
  sqlq "select m.name || '.' || p.name || '  ' || p.type from sqlite_schema m join pragma_table_info(m.name) p where m.name in ('ticket','ticketchng','backlink') order by m.name, p.cid;"
}

# safe mode keeps the shell from writing files, running commands, or opening other databases
readonly_sql() { fossil sql --readonly -safe -R "$REPO" "$@"; }

verb_sql() {
  need
  printf 'select 1;\n' | readonly_sql >/dev/null 2>&1 || die "fossil sql --readonly -safe failed; tkt sql needs a fossil whose sqlite shell has safe mode"
  if [ "$1" = --schema ]; then schema_notes; return; fi
  if [ $# -eq 0 ] && [ -t 0 ]; then exec fossil sql --readonly -safe -R "$REPO"; fi
  local q err rc=0
  if [ $# -gt 0 ]; then q="$*"; else q=$(cat); fi
  [ -n "$q" ] || die 'usage: tkt sql <query>, the query on stdin, or tkt sql --schema'
  err=$(mktemp)
  printf '%s\n' "$q" | readonly_sql -markdown -header -bail 2>"$err" || rc=$?
  # fossil exits zero after a failed statement, so any error text is the failure signal
  if [ -s "$err" ]; then cat "$err" >&2; rc=1; fi
  rm -f "$err"
  return $rc
}

# the Claude Code skill, which the test suite keeps identical to the copy under skills/tkt
skill_md() {
  cat <<'SKILL_MD'
---
name: tkt
description: File, read, update, and close tickets in a project's fossil ticket tracker through the tkt command. Use when the human mentions tickets, the tracker, tkt, or .tkt.fossil, asks to file or record a bug or todo, asks what is open, or when work fixes, blocks, or relates to an existing ticket.
allowed-tools: Bash(tkt:*)
---

# tkt

`tkt` is a ticket tracker over fossil. A ticket is a **description** plus **comments**. The
description is the current statement of the problem and is rewritten in place. Comments
are an append-only log beside it. Both are markdown.

Beyond plain markdown, both render ```` ```mermaid ```` and ```` ```pikchr ```` fences as diagrams and
highlight fences that name a language. A bare `[<hash>]` links to that ticket. Prefer a diagram
or a highlighted fence to ascii art. The full rules are on the tracker's `agents/FormattingHelp` wiki
page (`tkt status` prints the url; the page is `/wiki?name=agents/FormattingHelp`).

Run `tkt help` for the full verb list. This skill covers how to use it well.

## When invoked as /tkt

The human typed: `/tkt $ARGUMENTS`

Skip this section when that line shows no `/tkt` invocation. Otherwise act on the first match below.
The **active ticket** is the one most recently shown, filed, or changed in this conversation.

| Arguments | Do this |
| --- | --- |
| *(none)* | Run `tkt triage` and summarize it in a few lines. Name the active ticket, if any. |
| one hex word of 4+ characters matching exactly one ticket | Run `tkt show <id>` and summarize it: the problem, its state, and what is owed. It becomes the active ticket. |
| such a hex word, then an instruction | That ticket becomes the active ticket; follow the instruction for it, as below. Project actions run this way, as `/tkt <id> groom`. |
| `wiki map [focus]`, `map [focus]` | Work on the project's `Mapping` page; see *Map and diagram* below. |
| `wiki system [focus]`, `diagram [focus]` | Work on the project's `SystemDiagrams` page; see *Map and diagram* below. |
| `wiki ...` (anything else) | Treat it as a free-form instruction about the wiki. Read `agents/Home` first. |
| anything else | An instruction about the active ticket. First state the active ticket's id and title; if there is none, ask which ticket. Named instructions follow. |

Named instructions:

- `groom`: rewrite the description into the four sections, folding in what the comments
  settled; fix tags, severity, and links to related tickets. Show the result.
- `plan`: read the ticket and the code it touches, then propose steps. Change nothing.
- `review`: review the code against the ticket's requirements (its Symptom and Todo, and what
  the comments settled). Change nothing.
  - A closed ticket: say so first, then review anyway.
  - The work is usually the uncommitted diff (`git status`, `git diff HEAD`). It may also be
    partly committed already: check `git log` for commits naming the ticket or touching its files.
  - Report each requirement as met, partial, or missing, with `file:line`; then defects and
    risks beyond the requirements.
  - When `tkt` prints `running inside project action`, post the review as one comment on the
    ticket (`tkt comment <id>`). Otherwise reply in the session and post nothing.
- `close`: close only when the rules under *Closing* hold; otherwise say what is still owed.
- `note <text>`: add `<text>` as a comment, tidied into the ticket's voice.

### Map and diagram

The page is `Mapping` or `SystemDiagrams`. If it does not exist, start it with
`tkt wiki cp templates/<Name> <Name>`. Read `agents/Home` and the page, then follow its
*Conventions* and *Instructions*.

These jobs have no natural end, so work in bounded passes:

- With a focus (`/tkt map the serve lifecycle`), cover that focus. Without one, pick the most
  useful gap: an empty section, the *Unknowns* list, or the area the conversation is about.
- Stop after one substantial pass: about two sections, or one area explored in depth. Save
  with `tkt wiki put <Name> --base <version>` before stopping.
- Then report: what you added or changed, what is still missing, and the focus you suggest
  for the next pass. Do not start that pass unasked.

## Before the first call

```bash
tkt list
```

Run it alone, as written: every `tkt` call is a plain command starting with `tkt`, never chained with
`&&`, `;` or a pipe, so it matches a `Bash(tkt:*)` permission and runs where other commands are refused.

| Result | Action |
| --- | --- |
| `tkt: command not found` | Stop and give the human the install step from the tkt README. Do not fall back to raw `fossil` commands. |
| `no tracker at ...` | Ask the human before running `tkt init`, since it creates a file in their repository. |
| `schema predates the ... field` | Run `tkt init`. It is idempotent and only migrates. |
| `found a tracker under the old name` | Give the human the rename it names. Do not rename the file yourself. |
| `is not a tkt tracker` | Stop and report it. Never pass `--adopt` without the human's explicit yes for that repository. |

## Commands

Always pass bodies on stdin, never as an argument. Use a quoted heredoc: the quoted
delimiter keeps backticks, dollars, and angle brackets literal.

```bash
tkt new title='foo explodes' tags='compiler oop' <<'EOF'
## Symptom

`make foo` exits 2 with `unbound variable: bar`.
EOF
```

When a hook or permission rule blocks heredocs, or the body is long, write it to a draft
file with the Write tool and pipe it. Move or delete the draft once it is filed.

```bash
cat /tmp/ticket-body.md | tkt new title='foo explodes'
```

`tkt new` prints the new uuid. Its first ten characters are the id to use afterwards.

| Intent | Command |
| --- | --- |
| Read one ticket | `tkt show <id>` |
| List open tickets | `tkt list`, or `tkt list status=all tag=<word>` |
| What to work on | `tkt todo`, the 10 newest open tickets; `tkt todo 5 -f json` for fewer, as json |
| What is most urgent | `tkt triage`, only the top severity present among open tickets |
| Find a ticket | `tkt search <text>` |
| Restate the problem | `tkt edit <id> <<'EOF'` ... |
| Add to the record | `tkt comment <id> <<'EOF'` ... |
| Replace tags | `tkt tag <id> compiler oop`, or `--clear` |
| Declare what it waits on | `tkt block <id> <other-id>...`, or `--clear` |
| Make it a subtask | `tkt parent <id> <parent-id>`, or `--clear`; one level deep |
| List a ticket's subtasks | `tkt list parent=<id>` |
| Change one field | `tkt set <id> severity Critical` |
| Close | `tkt close <id> <<'EOF'` ... |

Optional fields for `new`: `type`, `status`, `severity`, `priority`, `subsystem`, `tags`,
`foundin`, `parent`. An unknown field name fails, so fix the spelling and rerun.

Never use `tkt run` for a write that a verb covers, and never edit `.tkt.fossil` directly.
`tkt run` is the human's escape hatch.

## Questions the verbs don't answer

Use `tkt sql` for any read-only question: what is ready to work, what went stale, counts
by tag. It can't change anything, so it's always safe to run.

- Run `tkt sql --schema` first. It explains the tables and gives two example queries.
- Pass the query as an argument, or on stdin for anything longer than a line.
- Never use `tkt run sql`. That is the human's unrestricted escape hatch.

```bash
tkt sql "select severity, count(*) as n from ticket where status != 'Closed' group by severity;"
```

## Search before filing

Run `tkt search <key term>` before `tkt new`. When a ticket already covers the problem,
comment on it or rewrite its description instead of filing a duplicate.

## Ticket structure

Someone acts on a ticket later without the context you have now, so write the destination,
not the journey. Four sections carry almost every description:

- **Symptom**: the real error text, quoted.
- **Repro**: the shortest command that shows it.
- **Cause**: where the defect lives, stated flatly.
- **Result** or **Todo**: what was fixed and what test pins it, or what is still owed.

Leave out what you tried first, what you ruled out, and commentary on tooling or process.
Put that in a notes file, not in the ticket.

## Edit or comment

| Situation | Verb |
| --- | --- |
| The description is wrong or out of date | `tkt edit`: rewrite the whole description. The old text stays in fossil's history. |
| New evidence, a status note, a partial fix | `tkt comment` |
| Comments have pushed the ticket out of the four sections | `tkt edit` to fold them back in, not another comment |

`tkt edit` replaces the description. Run `tkt show <id>` first and carry forward what
still holds.

## Cross-references

- **See also**: write `[<uuid>]` in any description or comment. `tkt` rewrites it into a
  link, and `tkt show` on the other ticket lists it under `Referenced by`. A code span such
  as `` `<uuid>` `` does not link.
- **Waits on**: use `tkt block` only when this ticket cannot proceed until the other one
  closes. Record only the waits-on direction; `tkt show` derives the reverse.

## Closing

Close a ticket yourself only when all three hold:

1. The fix is committed.
2. A test pins it.
3. You watched that test pass.

The closing comment names the commit and the test:

```bash
tkt close 896eb890 <<'EOF'
Fixed in abc1234, pinned by test_foo_unbound.
EOF
```

For any other resolution, pass `resolution=`, for example `resolution=Works_As_Designed`.
A fix that is uncommitted or unverified stays open, with a comment saying what is still
owed.

## Web ui

`tkt serve` runs in the foreground until stopped, and prints its url as its first line.
Each tracker has one server: a new `tkt serve`, from any terminal, stops the old one first.

- **Check first:** `tkt status` prints the url when a server is running, and fails when
  none is.
- **Offer, then start:** start a server only when the human wants the web ui. Run
  `tkt serve` as a background command, and tell the human three things: the url, that the
  server runs inside this session, and that running `tkt serve` in their own terminal
  takes it over there, in the foreground where they can watch and Ctrl-C it.
- **Port:** the default is 9080 for every project, so `serve` fails with `port ... is taken`
  when another project is already serving. Do not stop that other server. Pick a free port
  and pass it, `tkt serve port=9081`, and tell the human that adding `TKT_PORT=9081` to the
  project's `.env` beside `.tkt.fossil` makes it the default. Never edit `.env` yourself
  unless asked. `TKT_PORT` in the environment beats `.env`, and `port=` beats both.
- **Stop:** `tkt stop` works from anywhere.
- **What the human can do there:** file, edit, comment on, close, and reopen tickets.
  Blockers and parents are command-line only.

## Wiki

The tracker's wiki holds the project pages agents keep current. Start every wiki task at
`agents/Home`: it lists the pages and the rules for them.

| Intent | Command |
| --- | --- |
| List pages | `tkt wiki ls`, or `tkt wiki ls templates` |
| Read a page | `tkt wiki get <page>`; stderr gives its version |
| Write a page | `tkt wiki put <page> --base <version> <<'EOF'` ... |
| Start a page from a template | `tkt wiki cp templates/<Name> <Name>` |
| Retire a page | `tkt wiki rm <page> --base <version>` |

- Always `get` before `put`, and pass the version it printed as `--base`, so a human's edit made
  in between is never overwritten. When `put` reports the page changed, `get` it again and redo
  the edit on the new text.
- `put` replaces the whole page. Carry forward everything that still holds, including the
  page's *Conventions* section.
- Never write `agents/` pages, which humans own. `--force` exists for when the human asks.
- Use `cp` only from `templates/`. Fill the copy in; leave the template as it is.

## Actions

Project actions are commands the human can run from buttons in the web ui. `tkt action list`
shows them; `tkt action run <name> [<id>]` runs one as its button does, streaming its log and
exiting with its code. They need jq.

- They come from the `actions` key of `.tkt.json` beside the tracker: json once its whole-line `//`
  comments are dropped. Each is `{"name", "label", "icon", "command": [argv...], "comment"}`; `{ticket}`,
  `{repo}`, and `{tkt}` (tkt's own path) are filled in, `icon` is a tabler icon name, and `comment: true`
  posts the result to the ticket the run started from. The `config/Actions` wiki page is no longer read.
- `"skill": ["groom"]` instead of a command runs the top-level `agent` argv with its `{prompt}` set to
  `/tkt {ticket} groom`, so such a job may be you, running this skill.
- An action whose command uses `{ticket}` is a ticket action and needs an id; any other is a
  project action, where an id is optional and only says which ticket gets the comment.
  `tkt action list` shows each one's scope.
- Add or change actions only when the human asks: they run commands on their machine.
  Never edit `.tkt.json` unasked.
- `tkt action clean [--keep <n>]` retires old finished jobs to the temp dir; it deletes nothing.
- Prefer an existing action over an ad-hoc command when it does what the human wants, so the
  run lands in the same job history the web ui shows.

## Reporting

When you mention a ticket to the human, give its id and title. When `tkt status`
succeeds, also give the link: its url with `/ticket` replaced by `/tktview/<id>`.
SKILL_MD
}

# write the skill into one skills directory, refusing a symlinked one; returns 1 when it was not written
put_skill() {
  if [ -L "$1" ]; then note "$1 is a symlink; update the skill where it points instead"; return 1; fi
  mkdir -p "$1" && skill_md >"$1/SKILL.md"
}

# init installs the project skill only for agents the project already uses: a .claude/ (Claude Code), .pi/ (pi), or
# .agents/ (the shared agent skills location, which pi also finds from subdirectories) directory beside the tracker.
# it never creates one, and says what it did either way
init_skill() {
  local root agent dir found=
  root=$(dirname "$REPO")
  for agent in .claude .pi .agents; do
    [ -d "$root/$agent" ] || continue
    found=1
    dir=$root/$agent/skills/tkt
    if [ -f "$dir/SKILL.md" ] && skill_md | cmp -s - "$dir/SKILL.md"; then
      note "agent skill: $agent/skills/tkt/SKILL.md is already current"
    elif [ -f "$dir/SKILL.md" ]; then
      put_skill "$dir" && note "agent skill: found $agent/, updated $agent/skills/tkt/SKILL.md to this tkt's version"
    else
      put_skill "$dir" && note "agent skill: found $agent/, installed $agent/skills/tkt/SKILL.md so agents in this project know how to use tkt"
    fi
  done
  [ -n "$found" ] || note "agent skill: no .claude/, .pi/, or .agents/ beside the tracker, so none installed; run 'tkt skill install --project' to add one here, or 'tkt skill install' for every project"
}

verb_skill() {
  local dir
  case "$1 $2" in
    ' ') skill_md; return ;;
    'install ') dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/tkt ;;
    'install --project') dir=$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/skills/tkt ;;
    *) die 'usage: tkt skill [install [--project]]' ;;
  esac
  [ ! -L "$dir" ] || die "$dir is a symlink; update the skill where it points instead"
  put_skill "$dir"
  note "installed $dir/SKILL.md"
}

verb_run() {
  need
  [ $# -gt 0 ] || die 'usage: tkt run <fossil args...>'
  fx "$@"
}

# wiki pages, for agents keeping the project's pages current. pages are markdown; a page emptied by rm is hidden
# by fossil and treated as absent here. each page's latest version id lets put and rm refuse a stale write (--base)
wiki_name() {
  case "$1" in
    '') die 'a page name is required' ;;
    /*|*/|*//*) die "bad page name: $1" ;;
    branch/*|tag/*|checkin/*) die "fossil reserves the ${1%%/*}/ prefix for its own notes; pick another name" ;;
  esac
}
# the latest version of a page as 'uuid|mark', where mark is - for an emptied page; nothing when it never existed
wiki_head() {
  sqlq "select b.uuid || '|' || substr(e.comment,1,1) from event e join blob b on b.rid=e.objid where e.type='w' and substr(e.comment,2)=$(lit "$1") order by e.mtime desc, e.objid desc limit 1;"
}
wiki_exists() { local h; h=$(wiki_head "$1"); [ -n "$h" ] && [ "${h##*|}" != - ]; }
wiki_version() { local h; h=$(wiki_head "$1"); h=${h%%|*}; printf '%s' "${h:0:10}"; }
# a write needs --force for agents/ pages, which agents are told not to edit, and --base must match the latest version
wiki_guard() {
  local page=$1 base=$2 force=$3 cur
  case "$page" in agents/*) [ -n "$force" ] || die "$page steers agents and is edited by humans; pass --force if you were asked to change it" ;; esac
  [ -z "$base" ] && return 0
  cur=$(wiki_version "$page")
  case "$cur" in "$base"*) [ -n "$cur" ] && return 0 ;; esac
  die "$page changed since version $base (now ${cur:-absent}); run tkt wiki show $page and redo the edit"
}
wiki_write() {
  local f
  f=$(mktemp)
  printf '%s\n' "$2" >"$f"
  if wiki_head "$1" | grep -q .; then fx wiki commit "$1" "$f" --mimetype text/x-markdown >/dev/null
  else fx wiki create "$1" "$f" --mimetype text/x-markdown >/dev/null; fi
  rm -f "$f"
}
wiki_usage() { die 'usage: tkt wiki ls|list [prefix] | get|show <page> | put <page> [--base <v>] [--force] | rm <page> [--base <v>] [--force] | cp|copy <page> <new-page> [--force]'; }

verb_wiki() {
  need
  local sub=${1:-} page= dst= base= force= body cur
  [ $# -eq 0 ] || shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || wiki_usage; base=$2; shift 2 ;;
      --base=*) base=${1#--base=}; shift ;;
      --force) force=1; shift ;;
      -*) wiki_usage ;;
      *) if [ -z "$page" ]; then page=$1; elif [ -z "$dst" ]; then dst=$1; else wiki_usage; fi; shift ;;
    esac
  done
  case "$sub" in
    list|ls)
      [ -z "$dst$base$force" ] || wiki_usage
      local where='' pre=${page%/}
      [ -z "$pre" ] || where="and (page=$(lit "$pre") or substr(page,1,$(( ${#pre} + 1 )))=$(lit "$pre/"))"
      sqlq "with w as (select substr(comment,2) as page, comment, mtime, objid, row_number() over (partition by substr(comment,2) order by mtime desc, objid desc) as n from event where type='w')
        select '| Page | Size | Updated |' || char(10) || '| --- | --- | --- |' union all
        select * from (select '| ' || page || ' | ' || (select size from blob where rid=w.objid) || ' | ' || datetime(mtime) || ' |' from w where n=1 and comment not like '-%' $where order by page collate nocase);" | paint ;;
    show|get)
      [ -n "$page" ] && [ -z "$dst$base$force" ] || wiki_usage
      wiki_name "$page"
      wiki_exists "$page" || die "no wiki page $page; tkt wiki list shows them"
      fx wiki export "$page"
      note "$page is at version $(wiki_version "$page"); tkt wiki put $page --base $(wiki_version "$page") refuses if it changes first" ;;
    put)
      [ -n "$page" ] && [ -z "$dst" ] || wiki_usage
      wiki_name "$page"
      wiki_guard "$page" "$base" "$force"
      body=$(slurp editor)
      [ -n "$(printf '%s' "$body" | tr -d ' \t\n')" ] || die 'nothing on stdin; to retire a page use tkt wiki rm'
      if wiki_exists "$page" && [ "$(fx wiki export "$page")" = "$body" ]; then note "$page is unchanged"; return; fi
      if wiki_exists "$page"; then cur=updated; else cur=created; fi
      wiki_write "$page" "$body"
      note "$cur $page, now at version $(wiki_version "$page")" ;;
    rm)
      [ -n "$page" ] && [ -z "$dst" ] || wiki_usage
      wiki_name "$page"
      wiki_exists "$page" || die "no wiki page $page"
      wiki_guard "$page" "$base" "$force"
      local f; f=$(mktemp)
      fx wiki commit "$page" "$f" --mimetype text/x-markdown >/dev/null
      rm -f "$f"
      note "removed $page; its history stays in fossil" ;;
    copy|cp)
      [ -n "$page" ] && [ -n "$dst" ] && [ -z "$base" ] || wiki_usage
      wiki_name "$page"; wiki_name "$dst"
      wiki_exists "$page" || die "no wiki page $page"
      # copying is for starting a page from a template; any other copy is usually a rename gone wrong
      case "$page" in templates/*) ;; *) [ -n "$force" ] || die "$page is not a template; copying it duplicates its content, so pass --force if that is what you want" ;; esac
      ! wiki_exists "$dst" || die "$dst already exists; use tkt wiki put $dst to replace it"
      case "$dst" in agents/*) [ -n "$force" ] || die "$dst steers agents and is edited by humans; pass --force if you were asked to create it" ;; esac
      wiki_write "$dst" "$(fx wiki export "$page")"
      note "copied $page to $dst, now at version $(wiki_version "$dst")" ;;
    *) wiki_usage ;;
  esac
}

# project actions: buttons that run project commands on the server, from fossil's /ext CGI, and the same runs
# from the cli. each is configured as
#   {"name": "a-z0-9-", "label": "Button text", "command": ["argv", "{ticket}"], "comment": true}
# command is an argv, run without a shell from the tracker's directory, with {ticket}, {repo}, and {tkt} (this
# script, for actions that call tkt back) filled in; comment
# posts the exit code and the log's tail to the ticket. names are what fossil allows in an /ext path. jq reads them
ACTION_TAIL=40
TABLER_ICONS=https://cdn.jsdelivr.net/npm/@tabler/icons@3.19.0/icons/outline
JOBS_KEEP=20
# the wiki page actions were configured on before .tkt.json; no longer read, only named so its owner can move off it
OLD_ACTIONS_PAGE=config/Actions

have_jq() { command -v jq >/dev/null; }

# actions live in .tkt.json beside the tracker, under its actions key. jq reads plain json, so whole-line // comments
# are dropped first, json5-style, which lets the file explain itself; a // inside a value is left alone
actions_file() { printf '%s/.tkt.json' "$(dirname "$REPO")"; }
config_json() { sed -e '/^[[:space:]]*\/\//d' "$(actions_file)"; }
config_ok() { [ -f "$(actions_file)" ] && config_json | jq -e 'type == "object"' >/dev/null 2>&1; }
actions_json() {
  [ -f "$(actions_file)" ] || return 0
  if ! config_ok; then note "$(actions_file) is not valid json, even without its // comments, so there are no actions"; return 0; fi
  # a skill action is shorthand for the agent running the tkt skill on the ticket: its words follow /tkt {ticket},
  # and that prompt fills the agent's {prompt}. without an agent that has one, a skill action is skipped
  config_json | jq '(.agent | if type == "array" and any(.[]; type == "string" and contains("{prompt}")) then map(tostring) else null end) as $agent
    | [(.actions // [])[]? | if type == "object" and (.skill | type == "array") and (has("command") | not) then
        (if $agent then (["/tkt {ticket}"] + (.skill | map(tostring)) | join(" ")) as $p
          | . + {command: ($agent | map(gsub("\\{prompt\\}"; $p)))} else empty end)
      else . end]'
}

# a tracker that still has the old wiki page is told once per listing, and by init, where its actions belong now
old_actions_page() {
  if wiki_exists "$OLD_ACTIONS_PAGE" 2>/dev/null; then
    note "the $OLD_ACTIONS_PAGE wiki page is no longer read; move its actions into $(actions_file), then tkt wiki rm $OLD_ACTIONS_PAGE"
  fi
}

# the commented starting config init writes when there is none; its comments are the format's documentation
default_config() {
  cat <<EOF
// tkt project actions: buttons in the web ui that run commands on the server, at /ext/tkt and on each ticket.
// \`tkt action list\` shows them and \`tkt action run <name> [<id>]\` runs one from the command line. They need jq.
// This file is json once its whole-line // comments are dropped.
//
// Each action:
//   name     lowercase letters, digits and dashes; part of the url
//   label    the button text; defaults to the name
//   command  the argv, run from this directory without a shell, so an argument may hold spaces.
//            {ticket} becomes the ticket id, {repo} the tracker's path, and {tkt} tkt's own path.
//            plain tkt is the same tkt too, since a job's PATH starts with it
//   comment  optional; true posts the exit code and the last $ACTION_TAIL lines of output to the ticket the run
//            started from
//   icon     optional; a tabler icon name, as https://tabler.io/icons shows them, such as "player-play".
//            it loads from the cdn, so offline the button shows its label alone
//
// A command that uses {ticket} makes a ticket action: its button shows only on ticket pages, and it runs once at
// a time per ticket. Any other is a project action: its button shows everywhere, and run from a ticket, that
// ticket only says where a comment goes.
//
// Every run is a job, kept in .tkt.fossil.jobs/ with its command, log and exit code. Clean Jobs retires all but
// the newest $JOBS_KEEP to \${TMPDIR:-/tmp}/tkt-jobs/, where nothing is deleted.
//
// skill   instead of command: the words of a tkt skill instruction, run by the agent on the ticket. ["groom"]
//          makes the prompt "/tkt {ticket} groom", which fills {prompt} in the agent's argv; so a skill action is
//          always a ticket action, and is skipped while there is no agent
//
// The agent is the coding agent, set once for every skill action: an argv with a {prompt}. tkt is not tied to
// one; the line below is Claude Code, headless, with the tracker and read-only tools. Drop its // to use it.
//
// More, to copy into the list below:
//   {"name": "test", "label": "Run tests", "icon": "player-play", "comment": true, "command": ["make", "test"]}
//   {"name": "groom", "label": "Groom", "icon": "wand", "skill": ["groom"]}
//   {"name": "review", "label": "Review", "icon": "eye-check", "skill": ["review"]}
{
//"agent": ["claude", "-p", "{prompt}", "--permission-mode", "dontAsk", "--allowedTools", "Bash(tkt:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Read", "Grep", "Glob"],
  "actions": [
    {"name": "clean-jobs", "label": "Clean Jobs", "icon": "archive", "command": ["tkt", "action", "clean", "--keep", "$JOBS_KEEP"]}
  ]
}
EOF
}

# init writes the default config only where there is none, and never touches one that exists
init_config() {
  if [ -e "$(actions_file)" ]; then return 0; fi
  default_config >"$(actions_file)"
  note "project actions: wrote $(actions_file), with Clean Jobs and the format in its comments"
}

# a ticket relates to a job in three ways, each with one rule:
#   input    an action whose command uses {ticket} is a ticket action: it runs only against a ticket, shows only
#            where there is one, and runs once at a time per ticket. any other is a project action, once at a time
#   output   comment posts the result to the ticket the job ran from, for either kind; without one, nothing is posted
#   context  a job records the ticket it ran from, when there is one, whatever its kind
#
# every valid action as name<TAB>label<TAB>comment|-<TAB>ticket|project<TAB>argv..., tsv-escaped by jq; invalid
# entries are skipped, and no config or no jq gives nothing
actions() {
  have_jq || return 0
  actions_json | { jq -r '.[]? | select((.name | type == "string" and test("^[a-z0-9-]+$")) and (.command | type == "array" and length > 0))
    | (.command | map(tostring)) as $argv
    | [.name, (.label // .name), (if .comment then "comment" else "-" end), (if any($argv[]; contains("{ticket}")) then "ticket" else "project" end),
       (if (.icon | type == "string" and test("^[a-z0-9-]+$")) then .icon else "-" end)]
      + $argv | @tsv' 2>/dev/null || true; }
}
action_line() { actions | awk -F'\t' -v n="$1" '$1 == n { print; exit }'; }
action_scope() { action_line "$1" | cut -f4; }

# a job is a directory beside the tracker: action, ticket, cmd (as run), pid, log, and exit once it ends
jobs_dir() { printf '%s.jobs' "$REPO"; }

job_running() { [ -f "$1/pid" ] && [ ! -f "$1/exit" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }

# done once it wrote its exit code, running while its pid lives, died otherwise (killed, reboot). with no pid file
# yet it is still starting, since the pid is written just after the fork. the exit file is looked at again after
# the pid, since a job that ends between the two looks wrote it just before it went
job_state() {
  if [ -f "$1/exit" ]; then printf 'exit %s' "$(cat "$1/exit")"
  elif [ ! -f "$1/pid" ] || job_running "$1"; then printf running
  elif [ -f "$1/exit" ]; then printf 'exit %s' "$(cat "$1/exit")"
  else printf died; fi
}

# job ids, newest first. ids sort by start time
job_ids() {
  local d all=()
  for d in "$(jobs_dir)"/*/; do [ -d "$d" ] && all+=("$(basename "$d")"); done
  [ ${#all[@]} -gt 0 ] || return 0
  printf '%s\n' "${all[@]}" | sort -r
}

# the id of a running job of this action, if any: a project action runs once at a time, a ticket action once per
# ticket. args: action, scope, ticket
job_active() {
  local id dir
  while read -r id; do
    dir=$(jobs_dir)/$id
    [ "$(cat "$dir/action")" = "$1" ] || continue
    if [ "$2" = ticket ] && [ "$(cat "$dir/ticket" 2>/dev/null)" != "$3" ]; then continue; fi
    if job_running "$dir"; then printf '%s' "$id"; return; fi
  done < <(job_ids)
}

# what became of a job's comment: posted, failed, or not posted for want of a ticket; nothing for an action without one
job_posted() { cat "$1/posted" 2>/dev/null || true; }

# start an action in the background and print its job id; an action already running prints that job's id instead.
# one fork with every fd closed off, so a CGI request ends at once; launchd or init adopts and reaps the job once
# its parent exits. it keeps the server's process group, so a foreground server's Ctrl-C ends running jobs too
job_start() {
  local name=$1 tid=$2 line id dir w flag scope
  local -a fields cmd=()
  line=$(action_line "$name")
  [ -n "$line" ] || die "no action named $name; tkt action list shows them"
  IFS=$'\t' read -ra fields <<<"$line"
  flag=${fields[2]}
  scope=${fields[3]}
  [ "$scope" = project ] || [ -n "$tid" ] || die "$name is a ticket action, since its command uses {ticket}; give it a ticket id"
  id=$(job_active "$name" "$scope" "$tid")
  if [ -n "$id" ]; then printf '%s' "$id"; return; fi
  for w in "${fields[@]:5}"; do
    w=$(printf '%b' "$w")
    w=${w//\{ticket\}/$tid}
    w=${w//\{tkt\}/$(self_path)}
    cmd+=("${w//\{repo\}/$REPO}")
  done
  id=$(date +%Y%m%d-%H%M%S)-$$
  dir=$(jobs_dir)/$id
  mkdir -p "$dir"
  printf '%s' "$name" >"$dir/action"
  printf '%s' "$tid" >"$dir/ticket"
  date +%s >"$dir/started"
  printf '%q ' "${cmd[@]}" >"$dir/cmd"
  ext_link
  (
    set +e
    unset CONTENT_LENGTH CONTENT_TYPE QUERY_STRING REQUEST_METHOD PATH_INFO SCRIPT_NAME SCRIPT_FILENAME REQUEST_URI HTTP_REFERER HTTP_COOKIE
    cd "$(dirname "$REPO")"
    # TKT_JOB marks every tkt run inside the job, so an agent the action starts learns where it is from tkt itself
    export PATH="$REPO.ext:$PATH" TKT_DB=$REPO TKT_JOB=$id TKT_ACTION=$name
    "${cmd[@]}" >"$dir/log" 2>&1 </dev/null
    rc=$?
    if [ "$flag" = comment ] && [ -z "$tid" ]; then
      echo 'not posted: no ticket' >"$dir/posted"
    elif [ "$flag" = comment ]; then
      # fossil's own output goes to the log, so a failure there can be read
      if { printf 'action `%s` exited %s\n\n```\n' "$name" "$rc"; tail -n "$ACTION_TAIL" "$dir/log"; printf '```\n'; } \
          | ( set -e; verb_comment "$tid" ) >"$dir/post.log" 2>&1
      then echo "posted to $tid" >"$dir/posted"
      else echo 'posting failed; see post.log in the job' >"$dir/posted"; fi
    fi
    echo "$rc" >"$dir/exit"
  ) </dev/null >/dev/null 2>&1 &
  echo $! >"$dir/pid"
  disown
  printf '%s' "$id"
}

action_usage() { die 'usage: tkt action list | run <name> [<id>] | clean [--keep <n>]'; }

# where clean retires jobs: under the temp dir, one folder per project, so nothing is deleted and the os clears it
jobs_retired_dir() { local t=${TMPDIR:-/tmp}; printf '%s/tkt-jobs/%s' "${t%/}" "$(basename "$(dirname "$REPO")")"; }

# retire every finished job but the newest keep: move each directory, its log and its record, out of the jobs list.
# a running job stays, and so does the job doing the cleaning
jobs_clean() {
  local keep=$1 id i=0 n=0 dest
  dest=$(jobs_retired_dir)
  while read -r id; do
    i=$((i + 1))
    [ "$i" -gt "$keep" ] || continue
    [ "$id" != "${TKT_JOB:-}" ] || continue
    [ "$(job_state "$(jobs_dir)/$id")" != running ] || continue
    mkdir -p "$dest"
    mv "$(jobs_dir)/$id" "$dest/"
    n=$((n + 1))
  done < <(job_ids)
  if [ "$n" -gt 0 ]; then printf 'retired %s job(s) to %s; kept the newest %s\n' "$n" "$dest" "$keep"
  else printf 'nothing to retire; %s job(s), keeping the newest %s\n' "$i" "$keep"; fi
}

verb_action() {
  need
  case "${1:-}" in
    clean)
      local keep=$JOBS_KEEP
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --keep) [ $# -ge 2 ] || action_usage; keep=$2; shift 2 ;;
          --keep=*) keep=${1#--keep=}; shift ;;
          *) action_usage ;;
        esac
      done
      case "$keep" in ''|*[!0123456789]*) die "not a count: $keep" ;; esac
      jobs_clean "$keep"
      return ;;
  esac
  have_jq || die 'actions need jq; see https://jqlang.org'
  case "${1:-}" in
    list|ls)
      [ $# -le 1 ] || action_usage
      old_actions_page
      if [ -f "$(actions_file)" ]; then note "actions from $(actions_file)"; else note "no $(actions_file), so no actions; tkt init writes a starting one"; fi
      actions | awk -F'\t' 'BEGIN { print "| Action | Label | Icon | Scope | Comment | Command |"; print "| --- | --- | --- | --- | --- | --- |" }
        { c = $6; for (i = 7; i <= NF; i++) c = c " " $i; printf "| %s | %s | %s | %s | %s | `%s` |\n", $1, $2, ($5 == "-" ? "" : $5), $4, ($3 == "comment" ? "yes" : ""), c }' | paint ;;
    run)
      [ $# -ge 2 ] && [ $# -le 3 ] || action_usage
      local name=$2 tid= id dir state off=0 size
      if [ -n "${3:-}" ]; then tid=$(resolve "$3"); tid=${tid:0:10}; fi
      [ -n "$(action_line "$name")" ] || die "no action named $name in $(actions_file); tkt action list shows them"
      id=$(job_start "$name" "$tid")
      dir=$(jobs_dir)/$id
      note "job $id: $(cat "$dir/cmd")"
      # stream the log as it grows, then whatever came after the job's last look
      while :; do
        state=$(job_state "$dir")
        size=$(wc -c <"$dir/log" 2>/dev/null | tr -d ' ' || true)
        size=${size:-0}
        if [ "$size" -gt "$off" ]; then tail -c +$((off + 1)) "$dir/log" | head -c $((size - off)); off=$size; fi
        [ "$state" = running ] || break
        sleep 0.2
      done
      if [ -n "$(job_posted "$dir")" ]; then note "job $id: comment $(job_posted "$dir")"; fi
      case "$state" in
        died) die "job $id died without an exit code" ;;
        'exit 0') ;;
        *) note "job $id: $state"; return "${state#exit }" ;;
      esac ;;
    *) action_usage ;;
  esac
}

# --- fossil's /ext CGI: tkt serve links $REPO.ext/tkt to this script and passes --extroot. routes, under /ext/tkt:
#   GET  /ext/tkt[?ticket=ID]     the actions and recent jobs; no trailing slash, which fossil refuses
#   GET  /buttons?ticket=ID       the bare button row, unskinned, which the ticket page fetches into itself
#   POST /run/<name>              start an action (form field: ticket), then redirect to its job
#   GET  /job/<id>[?full=1]       a job's log, its tail refreshing until the job ends

# fossil runs us as CGI with no arguments. CGI vars reach every child, and a child fossil that sees
# GATEWAY_INTERFACE runs as CGI itself, so it goes once we know. fossil also scrubs PATH and HOME, and gives the
# repository relative to our cwd
is_cgi() { [ $# -eq 0 ] && [ -n "${GATEWAY_INTERFACE:-}" ] && [ -n "${FOSSIL_REPOSITORY:-}" ]; }
cgi_env() {
  local home=
  unset GATEWAY_INTERFACE
  case "$FOSSIL_REPOSITORY" in /*) REPO=$FOSSIL_REPOSITORY ;; *) REPO=$PWD/$FOSSIL_REPOSITORY ;; esac
  # the server's own user's home, so actions find their tools' settings and logins (a claude, a git config); the
  # login name is plain text, which makes the eval safe. user-installed tools in ~/.local/bin come first on PATH
  eval "home=~$(id -un)" 2>/dev/null || true
  case "$home" in /*) ;; *) home=$(dirname "$REPO") ;; esac
  export HOME=${HOME:-$home} TKT_DB=$REPO
  export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
  # USER is scrubbed too, and fossil needs one to write: the web user who pressed the button
  export USER=${FOSSIL_USER:-${REMOTE_USER:-$(id -un)}}
  BASE=$SCRIPT_NAME
}

html() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&#39;/g"; }
htmls() { printf '%s' "$1" | html; }

# one urldecoded field of a urlencoded string
form_field() {
  printf '%s' "$2" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1 \
    | sed 's/+/ /g; s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g' | xargs -0 printf '%b'
}

# the POST body: exactly CONTENT_LENGTH bytes, since fossil never closes our stdin (and macOS head refuses -c 0)
cgi_body() { if [ "${CONTENT_LENGTH:-0}" -gt 0 ]; then head -c "$CONTENT_LENGTH"; fi; }

# a skinned page: fossil wraps html in the skin only when it opens with a fossil-doc div, whose data-title titles
# the page. the div closes on exit, so an early cgi_fail still makes a whole page
cgi_page() {
  printf 'Status: %s\r\nContent-Type: text/html; charset=utf-8\r\n\r\n' "$1"
  printf "<div class='fossil-doc' data-title='%s'>\n" "$(htmls "$2")"
  trap 'printf "</div>\n"' EXIT
}
cgi_fail() { cgi_page "$1" "$1"; printf '<p>%s</p>\n' "$(htmls "$2")"; exit 0; }
cgi_redirect() { printf 'Status: 303 See Other\r\nLocation: %s\r\n\r\n' "$1"; }

# FOSSIL_NONCE is only the CSP nonce and fossil passes no Origin, so a POST must come from a page on this server
cgi_same_origin() { case "${HTTP_REFERER:-}" in "$REQUEST_SCHEME://$HTTP_HOST/"*) return 0 ;; esac; return 1; }

# the ticket a request names, in TID: nothing, or a uuid prefix matching exactly one ticket, as its 10-character id.
# not a $(...) helper, so its failure is the reply
cgi_ticket() {
  local hits
  TID=$(form_field ticket "$1")
  [ -n "$TID" ] || return 0
  case "$TID" in *[!0-9a-f]*) cgi_fail 400 "bad ticket id: $TID" ;; esac
  hits=$(sqlq "select substr(tkt_uuid,1,10) from ticket where tkt_uuid like '$TID%';")
  set -- $hits
  [ $# -eq 1 ] || cgi_fail 400 "$TID matches no single ticket"
  TID=$1
}

# the button row: one form per action, posting the ticket along; nothing at all when there are no actions
buttons() {
  local tid=$1 name label flag scope icon rest rows= text img
  while IFS=$'\t' read -r name label flag scope icon rest; do
    if [ "$scope" = ticket ] && [ -z "$tid" ]; then continue; fi
    text=$(htmls "$(printf '%b' "$label")")
    img=
    # tabler icons come from the cdn rather than a mirror of the set, so this is the one thing on these pages that
    # needs the network. the button's own text names it; offline the icon is simply missing
    if [ "$icon" != - ]; then img="<img class=\"tkt-action-icon\" src=\"$TABLER_ICONS/$icon.svg\" alt=\"\" width=\"16\" height=\"16\">"; fi
    rows="$rows$(printf '<form method="post" action="%s/run/%s"><input type="hidden" name="ticket" value="%s"><button title="%s">%s%s</button></form>' \
      "$BASE" "$name" "$tid" "$text" "$img" "$text")"$'\n'
  done < <(actions)
  if [ -n "$rows" ]; then printf '<div class="tkt-actions">\n%s</div>\n' "$rows"; fi
}

# the pages are drawn as the ticket view's cards: a label row with the fold and copy controls, which the skin's script
# drives on any .tkt-card, then a body. the copy takes the body's text
card_open() {
  local svg='<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"'
  local clip='<path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"/>'
  printf '<div class="tkt-card %s"><div class="tkt-card-label">%s<span class="tkt-card-ctl">' "$1" "$2"
  printf '<a href="#" class="tkt-fold" aria-label="Collapse">%s class="tkt-fold-up"><path d="M6 15l6 -6l6 6"/></svg>%s class="tkt-fold-down"><path d="M6 9l6 6l6 -6"/></svg></a>' "$svg" "$svg"
  printf '<a href="#" class="tkt-copy" aria-label="Copy contents">%s class="tkt-clip">%s</svg>%s class="tkt-clipped">%s<path d="M9 14l2 2l4 -4"/></svg></a>' "$svg" "$clip" "$svg" "$clip"
  printf '</span></div>\n<div class="tkt-card-body">'
}
card_close() { printf '</div></div>\n'; }

# a job's state as a badge: exit 0 passes, any other exit fails, died is muted
state_badge() {
  local cls
  case "$1" in 'exit 0') cls=ok ;; exit*) cls=bad ;; running) cls=run ;; *) cls=dead ;; esac
  printf '<span class="tkt-jobstate tkt-jobstate-%s">%s</span>' "$cls" "$(htmls "$1")"
}

# seconds as 4s, 2m 5s, or 1h 3m
span() {
  local s=$1
  if [ "$s" -lt 60 ]; then printf '%ss' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%sm %ss' $((s / 60)) $((s % 60))
  else printf '%sh %sm' $((s / 3600)) $((s % 3600 / 60)); fi
}

# when a job started, and how long it ran or has run so far; jobs from before the started file have neither
job_times() {
  local dir=$1 t0 t1
  [ -f "$dir/started" ] || return 0
  t0=$(cat "$dir/started")
  if [ -f "$dir/exit" ]; then t1=$(date -r "$dir/exit" +%s); else t1=$(date +%s); fi
  printf '%s\t%s' "$(date -r "$t0" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d "@$t0" '+%Y-%m-%d %H:%M:%S')" "$(span $((t1 - t0)))"
}

route_index() {
  local id dir src tid when took
  cgi_ticket "${QUERY_STRING:-}"
  cgi_page 200 Actions
  src="<a href=\"#config\"><code>.tkt.json</code></a>"
  card_open tkt-card-actions "Actions <span class=\"tkt-card-meta\">from $src${TID:+ &middot; for ticket <a href=\"/tktview/$TID\">$TID</a>}</span>"
  if ! have_jq; then printf '<p><strong>Actions need jq</strong>, which is not on the server&rsquo;s PATH.</p>\n'
  elif [ -z "$(actions)" ]; then printf '<p>None yet. Add them to %s.</p>\n' "$src"
  else
    buttons "$TID"
    # ticket actions need a ticket, so without one they are only named, as run from a ticket's page
    if [ -z "$TID" ]; then
      local named
      named=$(actions | awk -F'\t' '$4 == "ticket" { printf "%s%s", (n++ ? ", " : ""), $2 }')
      if [ -n "$named" ]; then printf '<p class="tkt-actions-note">From a ticket&rsquo;s page: %s.</p>\n' "$(htmls "$(printf '%b' "$named")")"; fi
    fi
  fi
  card_close
  card_open tkt-card-report 'Recent jobs'
  if [ -z "$(job_ids)" ]; then
    printf '<p class="tkt-jobs-none">No jobs yet.</p>\n'
  else
    printf '<table class="report"><thead><tr><th>Job</th><th>Action</th><th>Ticket</th><th>Started</th><th>Took</th><th>State</th></tr></thead><tbody>\n'
    while read -r id; do
      dir=$(jobs_dir)/$id
      tid=$(cat "$dir/ticket" 2>/dev/null || true)
      IFS=$'\t' read -r when took <<<"$(job_times "$dir")" || true
      printf '<tr><td><a href="%s/job/%s">%s</a></td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
        "$BASE" "$id" "$id" "$(html <"$dir/action")" "${tid:+<a href=\"/tktview/$tid\">$tid</a>}" "$when" "$took" \
        "$(state_badge "$(job_state "$dir")")"
    done < <(job_ids | head -n 25)
    printf '</tbody></table>\n'
  fi
  card_close
  card_open tkt-card-config "Config <span class=\"tkt-card-meta\" id=\"config\"><code>$(actions_file | html)</code></span>"
  if [ -f "$(actions_file)" ]; then printf '<pre>%s</pre>\n' "$(html <"$(actions_file)")"
  else printf '<p>No config yet; <code>tkt init</code> writes a starting one.</p>\n'; fi
  card_close
}

# unskinned, since it lands inside the ticket page
route_buttons() {
  cgi_ticket "${QUERY_STRING:-}"
  printf 'Content-Type: text/html; charset=utf-8\r\n\r\n'
  buttons "$TID"
}

route_run() {
  local name=$1 id
  [ "$REQUEST_METHOD" = POST ] || cgi_fail 405 'actions run only from a POST'
  cgi_same_origin || cgi_fail 403 "refused a request from another site (referer: ${HTTP_REFERER:-none})"
  have_jq || cgi_fail 503 'actions need jq, which is not on the server PATH'
  cgi_ticket "$(cgi_body)"
  [ -n "$(action_line "$name")" ] || cgi_fail 404 "no action named $name"
  [ "$(action_scope "$name")" = project ] || [ -n "$TID" ] || cgi_fail 400 "$name is a ticket action; run it from a ticket"
  id=$(job_start "$name" "$TID")
  cgi_redirect "$BASE/job/$id"
}

# the tail refreshes while the job runs; the full log holds still for reading
route_job() {
  local id=$1 dir state full lines tid when took meta keep=200
  case "$id" in ''|*/*|.*) cgi_fail 400 "bad job id: $id" ;; esac
  dir=$(jobs_dir)/$id
  [ -d "$dir" ] || cgi_fail 404 "no job $id"
  state=$(job_state "$dir")
  full=$(form_field full "${QUERY_STRING:-}")
  tid=$(cat "$dir/ticket")
  IFS=$'\t' read -r when took <<<"$(job_times "$dir")" || true
  cgi_page 200 "Job: $(cat "$dir/action")"
  # the skin's page reload toggle does the reloading, so the human can pause it to read
  if [ "$state" = running ] && [ -z "$full" ]; then printf '<meta name="tkt-reload" content="2">\n'; fi
  card_open tkt-card-fields "Job <span class=\"tkt-card-meta\">$id &middot; <a href=\"$BASE${tid:+?ticket=$tid}\">all actions and jobs</a></span>"
  printf '<table class="label-value">\n'
  printf '<tr><td class="tktDspLabel">Action:</td><td class="tktDspValue">%s</td></tr>\n' "$(html <"$dir/action")"
  printf '<tr><td class="tktDspLabel">Command:</td><td class="tktDspValue"><code>%s</code></td></tr>\n' "$(html <"$dir/cmd")"
  printf '<tr><td class="tktDspLabel">State:</td><td class="tktDspValue">%s</td></tr>\n' "$(state_badge "$state")"
  if [ -n "$tid" ]; then printf '<tr><td class="tktDspLabel">Ticket:</td><td class="tktDspValue"><a href="/tktview/%s">%s</a></td></tr>\n' "$tid" "$tid"; fi
  if [ -n "$(job_posted "$dir")" ]; then printf '<tr><td class="tktDspLabel">Comment:</td><td class="tktDspValue">%s</td></tr>\n' "$(job_posted "$dir" | html)"; fi
  if [ -n "$when" ]; then printf '<tr><td class="tktDspLabel">Started:</td><td class="tktDspValue">%s &middot; %s %s</td></tr>\n' "$when" "$( [ "$state" = running ] && echo 'running for' || echo took)" "$took"; fi
  printf '</table>\n'
  card_close
  # awk counts an unfinished last line too, as when a test runner prints dots
  lines=$(awk 'END { print NR }' "$dir/log" 2>/dev/null || true)
  lines=${lines:-0}
  if [ -z "$full" ] && [ "$lines" -gt "$keep" ]; then
    meta="last $keep of $lines lines &middot; <a href=\"$BASE/job/$id?full=1\">full log</a>"
  elif [ -n "$full" ]; then
    meta="$lines lines &middot; <a href=\"$BASE/job/$id\">tail</a>"
  else
    meta="$lines line$([ "$lines" = 1 ] || echo s)"
  fi
  card_open tkt-card-log "Log <span class=\"tkt-card-meta\">$meta</span>"
  printf '<pre>'
  if [ -z "$full" ] && [ "$lines" -gt "$keep" ]; then tail -n "$keep" "$dir/log" | html
  elif [ -f "$dir/log" ]; then html <"$dir/log"; fi
  printf '</pre>'
  card_close
}

cgi_main() {
  cgi_env
  case "${PATH_INFO:-}" in
    '') route_index ;;
    /buttons) route_buttons ;;
    /run/*) route_run "${PATH_INFO#/run/}" ;;
    /job/*) route_job "${PATH_INFO#/job/}" ;;
    *) cgi_fail 404 "no page ${PATH_INFO}" ;;
  esac
}

main() {
  if is_cgi "$@"; then cgi_main; return; fi
  local verb=${1:-help}
  [ $# -eq 0 ] || shift
  case "$verb" in
    help|-h|--help) usage | paint_help; return ;;
    version|--version) printf 'tkt %s\n' "$TKT_VERSION"; return ;;
    skill) verb_skill "$@"; return ;;
    init|new|show|list|search|todo|triage|edit|comment|tag|block|parent|set|close|clean|serve|stop|status|sql|wiki|action|run) ;;
    *) usage >&2; die "unknown verb: $verb" ;;
  esac
  locate
  "verb_$verb" "$@"
}

main "$@"
