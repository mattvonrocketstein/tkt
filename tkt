# mermaid diagrams (mindmaps, flowcharts, ...) from ```mermaid fences, drawn in the browser. fossil's markdown leaves them
# as <pre><code class=language-mermaid>. prism's deferred scripts run once the document turns interactive and highlight
# right away, so the blocks are claimed on that readystatechange, which fires before any deferred script runs. mermaid.min.js (~5.5MB, SRI-pinned) is fetched only on pages
# that have a block, and diagrams are redrawn when the theme flips. TKT_MERMAID=0 leaves it out
MERMAID_SRI=sha512-CaEn6DWYJ1MM0mFAT9nvJzd3z5gPsXTM7wzprb8wx615WzTnTSrGrbKkZUqe1s24lpW27X4HlIrSFvQm/ykqZA==

# offline copies: init stores the scripts above in the tracker as fossil unversioned files, named by their cdnjs path,
# and pages load them from $home/uv/ instead of the cdn. the prism autoloader finds grammars beside itself, so the
# grammars below are stored too; a fence in any other language stays plain. TKT_CDN is where init fetches from
CDN=https://cdnjs.cloudflare.com/ajax/libs
PRISM_PATH=prism/1.29.0
MERMAID_PATH=mermaid/12.3.0/mermaid.min.js
PRISM_LANGS='markup css clike javascript typescript jsx tsx c cpp csharp java kotlin scala groovy dart go rust swift
  python ruby php markup-templating perl lua r elixir erlang haskell ocaml zig nix tcl bash shell-session powershell
  batch sql json yaml toml ini diff markdown docker makefile nginx graphql protobuf hcl regex latex'

# true when the tracker holds a stored copy of this path
stored() { [ "$(sqlq "select count(*) from unversioned where name=$(lit "$1") and hash is not null;" 2>/dev/null)" = 1 ]; }

# where a page loads an asset from: the stored copy when there is one, else the cdn
asset_url() { if stored "$1"; then printf '$home/uv/%s' "$1"; else printf '%s/%s' "$CDN" "$1"; fi; }

# the subresource-integrity value of a file, in the hash its pin uses
sri_of() { printf '%s-%s' "$2" "$(openssl dgst "-$2" -binary "$1" | openssl base64 -A)"; }

# fetch the page scripts into the tracker, so the web ui needs no network. pinned files must match their sri.
# anything already stored is kept, so a rerun offline changes nothing, and a failure leaves pages on the cdn.
# /uv/ needs the check-out capability, which tkt serve's --localauth admin login has
store_assets() {
  local want=() src=${TKT_CDN:-$CDN} tmp user f sri lang get=() ok=() bad=0 err
  [ "${TKT_MERMAID:-1}" = 0 ] || want+=("$MERMAID_PATH $MERMAID_SRI")
  if [ "${TKT_HIGHLIGHT:-1}" != 0 ]; then
    want+=("$PRISM_PATH/components/prism-core.min.js $PRISM_CORE_SRI" "$PRISM_PATH/plugins/autoloader/prism-autoloader.min.js $PRISM_AUTOLOAD_SRI")
    for lang in $PRISM_LANGS; do want+=("$PRISM_PATH/components/prism-$lang.min.js"); done
  fi
  [ ${#want[@]} -gt 0 ] || return 0
  tmp=$(mktemp -d)
  for f in "${want[@]}"; do
    f=${f%% *}
    stored "$f" || get+=(-o "$tmp/$f" "$src/$f")
  done
  if [ ${#get[@]} = 0 ]; then rm -rf "$tmp"; return 0; fi
  if ! command -v curl >/dev/null || ! command -v openssl >/dev/null; then
    rm -rf "$tmp"; note "page scripts: curl and openssl are needed to store them offline; pages load them from cdnjs"; return 0
  fi
  note "page scripts: fetching $(( ${#get[@]} / 3 )) from $src for offline use"
  # one curl for everything not yet stored, in parallel; a file that fails to arrive is simply absent afterwards
  curl -fsSL --create-dirs --parallel --connect-timeout 10 --max-time 120 "${get[@]}" 2>/dev/null || true
  for f in "${want[@]}"; do
    sri=${f#* }; [ "$sri" != "$f" ] || sri=; f=${f%% *}
    [ -f "$tmp/$f" ] || { stored "$f" || bad=$((bad + 1)); continue; }
    if [ -n "$sri" ] && [ "$(sri_of "$tmp/$f" "${sri%%-*}" 2>/dev/null)" != "$sri" ]; then
      note "page scripts: $f does not match its pinned hash, skipped"; bad=$((bad + 1)); continue
    fi
    ok+=("$f")
  done
  # one add for all of them; each is named by its path under $tmp, which is its cdnjs path
  if [ ${#ok[@]} -gt 0 ]; then
    user=$(sqlq "select login from user where cap glob '*s*' order by uid limit 1;")
    if err=$(cd "$tmp" && fossil uv add "${ok[@]}" -R "$REPO" --user "$user" 2>&1 >/dev/null); then
      note "page scripts: stored ${#ok[@]} in the tracker"
    else
      note "page scripts: could not store them (${err:-fossil uv add failed}); pages load them from cdnjs"
      bad=$((bad + ${#ok[@]}))
    fi
  fi
  rm -rf "$tmp"
  [ $bad = 0 ] || note "page scripts: $bad not stored; pages load those from cdnjs until a later tkt init stores them"
}

mermaid_tags() {
  [ "${TKT_MERMAID:-1}" != 0 ] || return 0
  cat <<EOF
<script nonce="\$nonce">
document.addEventListener('readystatechange',function claim(){
  if(document.readyState!=='interactive') return;
  document.removeEventListener('readystatechange',claim);
  var h=document.documentElement, nodes=[];
  document.querySelectorAll('code.language-mermaid').forEach(function(c){
    var pre=c.parentNode, d=document.createElement('div');
    d.className='mermaid tkt-mermaid'; d.dataset.src=c.textContent; d.textContent=c.textContent;
    (pre.tagName==='PRE'?pre:c).replaceWith(d); nodes.push(d);
  });
  if(!nodes.length) return;
  function draw(){
    nodes.forEach(function(d){ d.removeAttribute('data-processed'); d.textContent=d.dataset.src; });
    mermaid.initialize({startOnLoad:false,theme:h.getAttribute('data-theme')==='dark'?'dark':'default',securityLevel:'strict'});
    mermaid.run({nodes:nodes,suppressErrors:true});
  }
  var s=document.createElement('script');
  s.src='$(asset_url "$MERMAID_PATH")'; s.integrity='$MERMAID_SRI'; s.crossOrigin='anonymous';
  s.onload=function(){
    draw();
    new MutationObserver(draw).observe(h,{attributes:true,attributeFilter:['data-theme']});
  };
  document.head.appendChild(s);
});
</script>
EOF
}

