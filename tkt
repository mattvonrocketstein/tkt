    zoomButtons();
    reloadToggle();
    menuGroups();
    bareSubmenu();
    reportCard();
    attachCard();
    // the details card's word-valued fields read in title case, with fossil's underscores as spaces. only text nodes change,
    // so tag links keep the stored value in their hrefs and the facet filter still matches
    [].forEach.call(document.querySelectorAll('.tkt-card-fields table.label-value tr'),function(r){
