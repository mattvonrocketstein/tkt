# the github project behind the tracker's directory, as https://github.com/owner/repo, when origin points there
github_url() {
  local url
  url=$(git -C "$(dirname "$REPO")" remote get-url origin 2>/dev/null) || return 1
  case "$url" in
    git@github.com:*) url=${url#git@github.com:} ;;
    ssh://git@github.com/*) url=${url#ssh://git@github.com/} ;;
    https://github.com/*) url=${url#https://github.com/} ;;
    *) return 1 ;;
  esac
  url=${url%/}; url=${url%.git}
  case "$url" in */*/*|*/|/*|'') return 1 ;; esac
  printf 'https://github.com/%s' "$url"
}

# the default branch as origin knows it, else main
github_branch() {
  local ref
  ref=$(git -C "$(dirname "$REPO")" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null) && [ -n "${ref##*/}" ] && printf '%s' "${ref##*/}" || printf main
}

# the skin: fossil's built-in blitz, linked from the header rather than copied, plus a dark theme layered on top.
# the Dark link in the menu flips a data-theme attribute and remembers it per browser.
# with a github url, Actions | Issues | Main links follow the theme toggle
PRISM=https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0
PRISM_CORE_SRI=sha384-MXybTpajaBV0AkcBaCPT4KIvo0FzoCiWXgcihYsw4FUkEz0Pv3JGV6tk2G8vJtDc
PRISM_AUTOLOAD_SRI=sha384-Uq05+JLko69eOiPr39ta9bh7kld5PKZoU+fF7g0EXTAriEollhZ+DrN8Q/Oi8J2Q
# fossil's own csp plus the prism host, so the autoloader can fetch grammars; $nonce is filled in by fossil per page
CSP="default-src 'self' data:; script-src 'self' 'nonce-\$nonce' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src * data:"

# syntax highlighting is prism from a cdn, deferred, with no theme: token colors live in the skin css for both themes.
# it fails quietly offline, and TKT_HIGHLIGHT=0 leaves it out of the header entirely
prism_tags() {
  [ "${TKT_HIGHLIGHT:-1}" != 0 ] || return 0
  printf '<script nonce="$nonce" src="%s/components/prism-core.min.js" integrity="%s" crossorigin="anonymous" defer></script>\n' "$PRISM" "$PRISM_CORE_SRI"
  printf '<script nonce="$nonce" src="%s/plugins/autoloader/prism-autoloader.min.js" integrity="%s" crossorigin="anonymous" defer></script>\n' "$PRISM" "$PRISM_AUTOLOAD_SRI"
}

