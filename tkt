#!/usr/bin/env bash

# tkt: a ticket tracker over fossil, with a mutable description beside an append-only comment log.
set -eo pipefail

TKT_VERSION=0.1.0
FIELDS='tags blockers parent description'
GUEST=hjr
MENU="Reports /ticket r {} {Project Wiki} /rptview?title=Wiki+Pages j {} Login /login !L desktoponly"
COLS="substr(tkt_uuid,1,10) || ' | ' || coalesce(nullif(status,''),'-') || ' | ' || coalesce(nullif(severity,''),'-') || ' | ' || coalesce(nullif(trim(tags),''),'-') || ' | ' || coalesce(nullif(title,''),'(untitled)')"

# color only on a terminal, and never when either no-color variable is set or the terminal is dumb
colorful() { [ -z "${NO_COLOR:-}${NOCOLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t "$1" ]; }
if colorful 2; then E_RED=$'\033[31m' E_DIM=$'\033[2m' E_OFF=$'\033[0m'; fi
if colorful 1; then PAINT=1; fi

die() { printf '%stkt:%s %s\n' "$E_RED" "$E_OFF" "$*" >&2; exit 1; }

note() { printf '%stkt:%s %s\n' "$E_DIM" "$E_OFF" "$*" >&2; }

# on a terminal, help shows each command's verbs in bold and its placeholders in cyan, with the env variables
# the descriptions mention in yellow; the first line is bold. piped, it is plain text
paint_help() {
  if [ -z "$PAINT" ]; then cat; return; fi
  awk -v b=$'\033[1m' -v c=$'\033[36m' -v y=$'\033[33m' -v d=$'\033[2m' -v o=$'\033[0m' '
    function envs(s) { gsub(/\$?TKT_[A-Z_]+(=[0-9]+)?|\$(EDITOR|TKT_DB)/, y "&" o, s); return s }
    # one argument token: alternatives split on |, each placeholder or option in cyan, literal words plain.
    # depth carries an open [ or < across the spaces inside it, as in [-f FMT] or <fossil args...>
    function arg(t,   n, p, i, r, open) {
      open = depth > 0
      depth += gsub(/[\[<]/, "&", t) - gsub(/[\]>]/, "&", t)
      if (open) return c t o
      n = split(t, p, "|"); r = ""
      for (i = 1; i <= n; i++) r = r (i > 1 ? d "|" o : "") (p[i] ~ /^[<\[]|^-/ ? c p[i] o : p[i])
      return r
    }
    NR == 1 { print b $0 o; next }
    /^  tkt / {
      line = substr($0, 3)
      if (match(line, /  +/)) { cmd = substr(line, 1, RSTART - 1); rest = substr(line, RSTART) } else { cmd = line; rest = "" }
      n = split(cmd, t, " "); out = ""; verbs = 1; depth = 0
      for (i = 1; i <= n; i++) {
        if (verbs && t[i] !~ /^[a-z]+$/) verbs = 0
        out = out (i > 1 ? " " : "") (verbs ? b t[i] o : arg(t[i]))
      }
      print "  " out envs(rest); next
    }
    { print envs($0) }'
}

# on a terminal, highlight ids, status, and severity in rows, and headings in a shown ticket
paint() {
  if [ -z "$PAINT" ]; then cat; return; fi
  local b=$'\033[1m' d=$'\033[2m' r=$'\033[31m' g=$'\033[32m' y=$'\033[33m' c=$'\033[36m' o=$'\033[0m'
  sed -E \
    -e "s/^([0-9a-f]{10}) \\| /${b}\\1${o} | /" \
    -e "s/ \\| Open \\| / | ${g}Open${o} | /" \
    -e "s/ \\| WIP \\| / | ${y}WIP${o} | /" \
    -e "s/ \\| Closed \\| / | ${d}Closed${o} | /" \
    -e "s/ \\| Critical \\| / | ${r}Critical${o} | /" \
    -e "s/^(# .*)$/${b}\\1${o}/" \
    -e "s/^(## .*)$/${c}\\1${o}/" \
    -e "s/^---$/${d}---${o}/"
}

