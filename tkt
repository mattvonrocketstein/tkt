# dark selectors are prefixed with html[data-theme=dark], which also outranks blitz's own rules
skin_css() {
  cat <<'EOF'
.mainmenu ul li.active { background-image: none; }
/* blitz caps the page at 900px; use the window instead, with an 8% gutter each side */
div.container { max-width: none; width: 84%; }
/* the project name in the logo links to recent activity, but keeps the heading's look */
header .logo a.tkt-home { color: inherit; text-decoration: none; }
/* the title row centers its parts on one line, so the smaller page title sits level with the project name rather than on its baseline */
header .logo h1#page-title { display: inline-flex; align-items: center; }
header .logo h1#page-title small { line-height: 1; }
/* a dim, light divider between the project name and the page's subtitle */
header .logo .tkt-title-sep { display: inline-block; width: 1px; height: .55em; margin: 0 .45em; overflow: hidden; color: transparent; background-color: #c4cad0; }
html[data-theme=dark] header .logo .tkt-title-sep { background-color: #444c56; }
/* one header row: the logo on the left, the menu's icons on the right. fossil positions the sitemap dropdown absolutely,
   which in a centered flex row would put its top above the page, so it is pinned to the header's bottom edge instead */
header .container { display: flex; align-items: center; position: relative; }
header .logo { flex: 1 1 auto; }
header nav.mainmenu { flex: 0 0 auto; }
header nav.mainmenu ul { border-top: 0; }
header nav#hbdrop { top: 100%; left: 0; right: 0; z-index: 20; }
/* blitz spaces the sitemap's entries for touch; tighten them into a compact list */
#hbdrop li { margin: 0; line-height: 1.6; list-style: none; }
#hbdrop li a { padding: 1px 6px; }
#hbdrop ul ul { margin: 0 0 4px 0; padding-left: 18px; }
/* the ticket view's field table spans the page; the label column stays as narrow as its text */
table.label-value { width: 100%; }
table.label-value td.tktDspLabel { width: 1%; white-space: nowrap; }
/* in a card the field table drops blitz's boxed cells: muted labels, values on the same line, hairline rules between rows */
html .tkt-card table.label-value { border: 0; border-collapse: collapse; margin: 0; }
html .tkt-card table.label-value td { border: 0; background-color: transparent; padding: 6px 4px; vertical-align: top; }
html .tkt-card table.label-value tr + tr td { border-top: 1px solid #eceff2; }
html .tkt-card table.label-value td.tktDspLabel { padding-right: 18px; text-align: left; font-weight: normal; color: #6a737d; }
.tkt-card-fields .tkt-card-body { padding: 2px 12px; }
html[data-theme=dark] .tkt-card table.label-value td { background-color: transparent; }
html[data-theme=dark] .tkt-card table.label-value tr + tr td { border-top-color: #2a3038; }
html[data-theme=dark] .tkt-card table.label-value td.tktDspLabel { color: #8b949e; }
/* in the details card's label, the ticket's relation icons precede the card controls; a thin rule separates the two,
   and an end-of-series arrow shows dimmed */
.tkt-card-ctl .tkt-off { display: inline-flex; color: #8a8f95; opacity: .35; cursor: default; }
.tkt-card-ctl .tkt-ctl-sep { width: 1px; align-self: stretch; margin: 2px 4px; background-color: #d8dde2; }
html[data-theme=dark] .tkt-card-ctl .tkt-ctl-sep { background-color: #30363d; }
.tkt-clipped, .tkt-copied .tkt-clip { display: none; }
/* the jump icons after the ticket title: small, muted, separated by thin bars; tips open below, rightward */
#ticket-title small.tkt-jumps { display: inline-flex; align-items: center; gap: 6px; margin-left: 10px; vertical-align: middle; font-size: 16px; font-weight: normal; }
.tkt-jumps .tkt-jump-sep { color: #c4cad0; }
.tkt-jumps a { position: relative; display: inline-flex; color: #8a8f95; text-decoration: none; }
.tkt-jumps a:hover { color: #3b5c6b; }
.tkt-jumps svg { width: 18px; height: 18px; }
.tkt-jumps a[aria-label]:hover::after {
  content: attr(aria-label); position: absolute; top: calc(100% + 4px); left: 0; z-index: 10; white-space: nowrap; pointer-events: none;
  padding: 3px 8px; border-radius: 4px; font-size: 12px; line-height: 1.4; color: #fff; background-color: #3a4048; }
html[data-theme=dark] .tkt-jumps .tkt-jump-sep { color: #444c56; }
html[data-theme=dark] .tkt-jumps a:hover { color: #79b8d6; }
html[data-theme=dark] .tkt-jumps a[aria-label]:hover::after { color: #1b1f24; background-color: #d4d8de; }
/* related tickets (blocked by, subtasks): one per line, a small dimmed status mark before the linked title, its status as the hover hint */
.tkt-subtask + .tkt-subtask { margin-top: 2px; }
.tkt-actions { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
.tkt-actions form { margin: 0; }
/* the actions pages: the button row sits in its card's padding, the log and jobs table run edge to edge */
.tkt-card-actions .tkt-card-body { padding: 10px 12px; }
.tkt-card-actions .tkt-actions { margin: 0; }
.tkt-card-actions p.tkt-actions-note { margin-top: 8px; color: #6a737d; font-size: .9em; }
html[data-theme=dark] .tkt-card-actions p.tkt-actions-note { color: #8b949e; }
.tkt-actions button { display: inline-flex; align-items: center; gap: 6px; }
.tkt-action-icon { width: 16px; height: 16px; }
html[data-theme=dark] .tkt-action-icon { filter: invert(1); }
.tkt-card-actions p, .tkt-jobs-none { margin: 0; padding: 4px 0; }
.tkt-card-report .tkt-jobs-none { padding: 10px 12px; }
.tkt-card-log .tkt-card-body { padding: 0; }
.tkt-card-log pre { margin: 0; padding: 10px 12px; border: 0; border-radius: 0 0 7px 7px; max-height: 70vh; overflow: auto; }
.tkt-card-meta a { font-weight: normal; }
.tkt-jobstate { display: inline-block; padding: 0 8px; border-radius: 10px; font-size: .85em; font-weight: 600; line-height: 1.6; }
.tkt-jobstate-ok { color: #1a7f37; background-color: #dafbe1; }
.tkt-jobstate-bad { color: #cf222e; background-color: #ffebe9; }
.tkt-jobstate-run { color: #0969da; background-color: #ddf4ff; }
.tkt-jobstate-dead { color: #6a737d; background-color: #eceff2; }
html[data-theme=dark] .tkt-jobstate-ok { color: #3fb950; background-color: #12261e; }
html[data-theme=dark] .tkt-jobstate-bad { color: #f85149; background-color: #2d1214; }
html[data-theme=dark] .tkt-jobstate-run { color: #58a6ff; background-color: #121d2f; }
html[data-theme=dark] .tkt-jobstate-dead { color: #8b949e; background-color: #22272e; }
.tkt-mark { position: relative; display: inline-flex; vertical-align: -2px; margin-right: 6px; color: #888; opacity: .6; cursor: default; }
.tkt-mark:hover { opacity: 1; }
.tkt-mark svg { width: 14px; height: 14px; }
.tkt-mark[aria-label]:hover::after {
  content: attr(aria-label); position: absolute; right: calc(100% + 6px); top: 50%; transform: translateY(-50%); z-index: 10; white-space: nowrap; pointer-events: none;
  padding: 3px 8px; border-radius: 4px; font-size: 12px; line-height: 1.4; color: #fff; background-color: #3a4048; }
html[data-theme=dark] .tkt-mark[aria-label]:hover::after { color: #1b1f24; background-color: #d4d8de; }
/* attachments: one per line, the comment muted beside the file name */
.tkt-attach { padding: 3px 0; }
.tkt-attach + .tkt-attach { border-top: 1px solid #eceff2; }
.tkt-attach-cmt { color: #4a5560; }
html[data-theme=dark] .tkt-attach + .tkt-attach { border-top-color: #2a3038; }
html[data-theme=dark] .tkt-attach-cmt { color: #b1bac4; }
/* an icon beside a value (copy the ticket id or found-in commit, download an attachment): small and a dimmed neutral grey, with no tint to
   compete with the accent-colored icons; full strength on hover. its tip opens to the right */
html a.tkt-inlineicon { position: relative; display: inline-flex; vertical-align: -2px; margin-left: 6px; color: #888; opacity: .6; text-decoration: none; }
