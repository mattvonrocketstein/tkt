  // page reload, a menu toggle left of the theme toggle: a page that follows something live, such as a running job,
  // carries a tkt-reload meta naming its period in seconds, and reloads that often while the toggle is on. the choice
  // is kept per browser; on shows the refresh icon, off the refresh-alert one, since the page may be going stale
  function reloadToggle(){
    var th=document.querySelector('.mainmenu li.tkt-themeli'); if(!th) return;
    var rk='tkt-reload', on=true, timer=null, meta=document.querySelector('meta[name="tkt-reload"]');
    try { on=localStorage.getItem(rk)!=='off'; } catch(e){}
    var arrows='<path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>';
    var alert='<path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/><path d="M12 9l0 3"/><path d="M12 15l.01 0"/>';
    var li=document.createElement('li'), a=document.createElement('a');
    li.className='tkt-menuicon tkt-reloadli'; a.href='#';
    function draw(){
      a.innerHTML='<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(on?arrows:alert)+'</svg>';
      a.setAttribute('aria-label','Page Reload: '+(on?'On':'Off'));
