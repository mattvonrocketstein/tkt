# web reports, one row each in fossil's reportfmt table. a column named '#' links to the ticket.
# rows carry no color and the reports no key: status and severity are sortable, filterable columns instead
reports() {
  cat <<'EOF'
CREATE TEMP TABLE r(title, cols, sqlcode);
INSERT INTO r VALUES('Open Tickets', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, severity, subsystem, tags, title
FROM ticket
WHERE status IN (''Open'',''WIP'')
ORDER BY CASE severity WHEN ''Critical'' THEN 0 WHEN ''Severe'' THEN 1 WHEN ''Important'' THEN 2 WHEN ''Minor'' THEN 3 ELSE 4 END, tkt_mtime DESC');
INSERT INTO r VALUES('Critical and Severe', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, severity, subsystem, tags, title
FROM ticket
WHERE status IN (''Open'',''WIP'') AND severity IN (''Critical'',''Severe'')
ORDER BY severity, tkt_mtime DESC');
INSERT INTO r VALUES('Recent Activity', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, severity, subsystem, tags, title
FROM ticket
WHERE tkt_mtime > julianday(''now'',''-30 days'')
ORDER BY tkt_mtime DESC');
INSERT INTO r VALUES('By Tag', '', 'WITH RECURSIVE split(tkt_id, tag, rest) AS (
  SELECT tkt_id, '''', trim(coalesce(tags,''''))||'' '' FROM ticket WHERE status IN (''Open'',''WIP'') AND trim(coalesce(tags,'''')) <> ''''
  UNION ALL
  SELECT tkt_id, substr(rest,1,instr(rest,'' '')-1), ltrim(substr(rest,instr(rest,'' '')+1)) FROM split WHERE rest <> ''''
)
SELECT
  s.tag AS ''tag'',
  substr(t.tkt_uuid,1,10) AS ''#'',
  t.status, t.severity, t.subsystem, t.title
FROM split s JOIN ticket t ON t.tkt_id=s.tkt_id
WHERE s.tag <> ''''
ORDER BY s.tag, t.tkt_mtime DESC');
INSERT INTO r VALUES('Blocked', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, severity,
  (SELECT group_concat(substr(b.tkt_uuid,1,10) || '' '' || coalesce(b.title,''''), char(10)) FROM ticket b
    WHERE '' '' || coalesce(t.blockers,'''') || '' '' LIKE ''% '' || substr(b.tkt_uuid,1,10) || '' %''
       OR (trim(coalesce(b.parent,'''')) = substr(t.tkt_uuid,1,10) AND b.status IN (''Open'',''WIP''))) AS ''blocked by'',
  title
FROM ticket t
WHERE status IN (''Open'',''WIP'') AND (trim(coalesce(blockers,'''')) <> ''''
  OR EXISTS (SELECT 1 FROM ticket c WHERE trim(coalesce(c.parent,'''')) = substr(t.tkt_uuid,1,10) AND c.status IN (''Open'',''WIP'')))
ORDER BY tkt_mtime DESC');
INSERT INTO r VALUES('Recently Closed', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''closed'',
  resolution, severity, subsystem, tags, title
FROM ticket
WHERE status=''Closed''
ORDER BY tkt_mtime DESC LIMIT 100');
INSERT INTO r VALUES('Tagged Tickets', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, severity, subsystem, tags, title
FROM ticket
WHERE trim(coalesce(tags,'''')) <> ''''
ORDER BY status=''Closed'', tkt_mtime DESC');
INSERT INTO r VALUES('By State', '', 'SELECT
  substr(tkt_uuid,1,10) AS ''#'',
  datetime(tkt_mtime) AS ''mtime'',
  status, type, severity, subsystem, title
FROM ticket
ORDER BY status=''Closed'', tkt_mtime DESC');
INSERT INTO r VALUES('Wiki Pages', '', 'WITH w AS (
  SELECT substr(comment,2) AS page, comment, mtime, objid,
    row_number() OVER (PARTITION BY substr(comment,2) ORDER BY mtime DESC) AS n,
    count(*) OVER (PARTITION BY substr(comment,2)) AS edits,
    min(mtime) OVER (PARTITION BY substr(comment,2)) AS created
  FROM event WHERE type=''w''
)
SELECT
  page,
  (SELECT size FROM blob WHERE rid=w.objid) AS ''size'',
  edits AS ''edits'',
  datetime(created) AS ''created'',
  datetime(mtime) AS ''mtime''
FROM w
WHERE n=1 AND comment NOT LIKE ''-%''
ORDER BY page');
DELETE FROM reportfmt WHERE title IN (SELECT title FROM r);
INSERT INTO reportfmt(owner, title, mtime, cols, sqlcode)
  SELECT 'tkt', title, strftime('%s','now'), cols, sqlcode FROM r;
DROP TABLE r;
EOF
}

# the formatting guide: one markdown page, seeded by init as the wiki page below and linked from the wiki's Help.
# tkt owns it, so init rewrites it whenever this text changes; local edits to the page do not survive an init
GUIDE_PAGE='agents/FormattingHelp'
format_guide() {
  local langs
  langs=$(printf '%s\n' $PRISM_LANGS | grep -vx -e clike -e markup-templating | sed 's/^markup$/html/' | sort | sed 's/.*/`&`/' | paste -sd, - | sed 's/,/, /g')
  cat <<EOF
# Formatting Help

Wiki pages, ticket descriptions, and ticket comments are all markdown, and render the same way.
Fossil's own [markdown reference](/md_rules) covers the basics; this page covers what tkt adds.

## Links

| To | Write | Notes |
| --- | --- | --- |
| a wiki page | \`[Home](/wiki?name=Home)\` | spaces in names become \`+\` |
| a ticket | \`[](9e66bb5bc7)\` | shows the hash; \`tkt\` rewrites a bare \`[9e66bb5bc7]\` into this form |
| a ticket, with text | \`[the pid bug](/tktview/9e66bb5bc7)\` | |
| a report | \`[Open](/rptview?title=Open+Tickets)\` | |
| a filtered report | \`[serve](/rptview?title=By+Tag#tag=serve)\` | |

A leading \`/\` is relative to the tracker. Reports can be linked but not embedded in a page.

## Code

A fence names its language and is highlighted by prism:

~~~markdown
\`\`\`python
print("hi")
\`\`\`
~~~

Highlighted languages: $langs.
A fence in any other language, or with none, stays plain. Use \`text\` for logs and output.

## Diagrams

Two kinds of fence draw diagrams.

**mermaid** is drawn in the browser. Flowcharts, state, sequence, and mindmap diagrams are known to work:

~~~markdown
\`\`\`mermaid
stateDiagram-v2
  [*] --> stopped
  stopped --> running: tkt serve
  running --> stopped: tkt stop
\`\`\`
~~~

draws as:

\`\`\`mermaid
stateDiagram-v2
  [*] --> stopped
  stopped --> running: tkt serve
  running --> stopped: tkt stop
\`\`\`

It runs in strict mode, so click handlers and html labels are ignored. A diagram that does not parse is left as its source text, with no error.

**pikchr** is built into fossil and drawn on the server, so it needs no scripts:

~~~markdown
\`\`\`pikchr
box "cli" fit; arrow; cylinder "tracker" fit
\`\`\`
~~~

draws as:

\`\`\`pikchr
box "cli" fit; arrow; cylinder "tracker" fit
\`\`\`

Prefer a diagram to ascii art. Both kinds follow the light and dark themes.

## Turning things off

\`TKT_HIGHLIGHT=0\` and \`TKT_MERMAID=0\` at \`tkt init\` or \`tkt serve\` leave out prism and mermaid; their fences then show as plain code.
EOF
}

# seed a tkt-owned page from a function's output, committing only when its text changed so init does not pile up wiki versions
seed_owned() {
  local f
  f=$(mktemp)
  "$2" >"$f"
  if ! fx wiki export "$1" 2>/dev/null | cmp -s - "$f"; then
    fx wiki create "$1" "$f" --mimetype text/x-markdown >/dev/null 2>&1 ||
      fx wiki commit "$1" "$f" --mimetype text/x-markdown >/dev/null
  fi
  rm -f "$f"
}

# the steering page: the one fixed place an agent starts from, linking to the pages the project keeps current.
# init seeds it once (see SEED_ONCE), so a project may tailor it
agent_home() {
  cat <<'EOF'
# Agent Home

Start here. This page is maintained by `tkt` and rewritten by `tkt init`, so do not edit it: put project
knowledge in the pages it links to.

## Pages

| Page | What it holds | Kept current by |
| --- | --- | --- |
| [System Diagrams](/wiki?name=templates/SystemDiagrams) | how the system is built: parts, control flow, data flow, lifecycles | whoever changes what it draws |
| [Mapping](/wiki?name=templates/Mapping) | working notes from exploring the code, rough and partly unverified, feeding System Diagrams | anyone exploring; promote what settles |
| [Lexicon](/wiki?name=templates/Lexicon) | the project's vocabulary: domain and system terms, abbreviations, words to avoid | whoever introduces or renames a term |
| [Style](/wiki?name=templates/Style) | how code, tests, commits, and prose are written here | whoever changes the practice or its tools |
| [Workflows](/wiki?name=templates/Workflows) | the commands for setup, build, run, test, release, and recovery | whoever changes a command |
| [Formatting Help](/wiki?name=agents/FormattingHelp) | markdown, links, highlighting, and diagrams on this tracker | `tkt`; read only |
| [Wiki Pages](/rptview?title=Wiki+Pages) | every wiki page, filterable by prefix: [agents](/rptview?title=Wiki+Pages#prefix=agents), [templates](/rptview?title=Wiki+Pages#prefix=templates) | |

## Standing rules

- **Read before you change.** Read the pages above that touch your task before starting it.
- **Keep pages current.** Update a page in the same change that makes it wrong. A stale page is worse
  than none.
- **Sources, in order of trust:** the code, then the docs and these pages, then tickets. Where they
  disagree, follow the code and file a ticket about the mismatch.
- **Describe what exists.** Planned work lives in tickets, not in these pages.
- **Link, don't repeat.** Link tickets as `[](<hash>)` and other pages by name instead of copying them.
  Name code paths in backticks.
- **Keep the headings.** A page's section headings are its structure; keep them even when a section is
  short.

## Template pages

A page that opens with a **Template** note has not been filled in yet. Fill it in following its
*Instructions* blocks, then delete that note and those blocks. Keep everything else on the page,
including its *Conventions* section: those rules hold for every later edit.
EOF
}


# template pages: project-agnostic starting points that agents fill in. unlike the guide, the project owns them,
# so init creates each one only when it is missing and never touches it again
system_diagrams_template() {
  cat <<'EOF'
# System Diagrams

> **Template.** This page has not been filled in yet. Follow [Agent Home](/wiki?name=agents/Home) and each
> *Instructions* block below, then delete this note and the *Instructions* blocks. Keep the
> *Conventions* section: it governs every later edit to this page.

## Conventions

- **Dialect:** mermaid for every diagram. Use pikchr only where exact placement carries meaning
  (a physical, network, or memory layout). Never ascii art. See [Formatting Help](/wiki?name=agents/FormattingHelp).
- **Size:** at most about 12 nodes per diagram. When a picture needs more, draw the coarse version and
  split the detail into its own subsection with its own diagram.
- **Names:** label nodes with the names used in the code (module, binary, table, service), so a reader
  can search for them, and use the same name for the same thing in every diagram on the page.
- **Plain syntax:** a mermaid diagram that fails to parse shows as plain text with no error. Use simple
  ids (`api`, `db`), labels in double quotes (`api["HTTP API"]`), no styling, no `click`, no html in labels.
- **Prose:** one to three sentences under each diagram saying what to notice, not a restatement of every arrow.
- **Current:** this page draws the system as it is. Change it in the same commit that changes what it draws.

## Overview

*Instructions:* one `flowchart LR` of the whole system: its major parts as nodes, and arrows labelled
with how they talk (call, http, queue, file, sql). Draw people and outside systems at the edges, using
the `(( ))` circle shape. Follow it with two or three sentences on what the system is for and who uses it.

## Components

*Instructions:* one entry per node in the overview, as a table with these columns:

| Component | Responsibility | Code | Tickets |
| --- | --- | --- | --- |
| `example` | one sentence on what it owns | `src/example/` | [](<hash>) |

Draw a component's insides only when they matter to someone changing it, as a subsection here with its
own small `flowchart`.

## Control flow

*Instructions:* what drives the system and in what order: entry points (commands, requests, jobs,
events), what each one calls, and where control branches, retries, or hands off to another process.
Use a `flowchart TD` with decision nodes (`check{"valid?"}`) for branching inside one process, or a
`sequenceDiagram` when the story is calls passing between processes. One diagram per important entry
point, starting with the most used one.

## Data flow

*Instructions:* how data moves and changes shape for the most important operation: where it enters,
each place it is transformed or stored, and where it leaves. Use a `flowchart LR` with data stores as
cylinders (`db[("orders")]`) and arrows labelled with what moves along them. If the system has a
persistent data model, add an `erDiagram` of the main tables or records, keys and relations only.

## Lifecycle

*Instructions:* if anything has states (a process, a request, a record, a ticket), draw them with
`stateDiagram-v2`: every state, the event or command on each transition, and the start and end states.
One diagram per thing that has states. Delete this section if nothing does.

## Open questions

*Instructions:* a bullet list of what was unclear, contradictory, or planned while drawing the above,
each linked to a ticket. File a ticket for any that has none.
EOF
}

