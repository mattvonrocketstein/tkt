Fields for new: title type status severity priority subsystem tags foundin parent.
Ids are uuid prefixes.  The tracker is $TKT_DB, else the nearest .tkt.fossil here or
above; init creates one at the git root, or here outside git.
EOF
}

# the nearest tracker at or above here, else a new one at the git root, else here
locate() {
  if [ -n "${TKT_DB:-}" ]; then
    case "$TKT_DB" in /*) REPO=$TKT_DB ;; *) REPO=$PWD/$TKT_DB ;; esac
    return
  fi
  local root=$PWD
  while :; do
    if [ -f "$root/.tkt.fossil" ]; then REPO=$root/.tkt.fossil; return; fi
    [ "$root" != / ] || break
    root=$(dirname "$root")
  done
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
  REPO=$root/.tkt.fossil
  if [ ! -f "$REPO" ] && [ -f "$root/.fossil.db" ] && owned "$root/.fossil.db"; then
    die "found a tracker under the old name $root/.fossil.db; rename it to .tkt.fossil or set TKT_DB"
  fi
}

fx() { fossil "$@" -R "$REPO"; }

sqlq() { { printf '.mode list\n.headers off\n'; printf '%s\n' "$@"; } | fossil sql -R "$REPO"; }

# a tkt tracker carries the version row, or predates it but has the blockers column only this schema adds
owned() {
  local REPO=$1 n
  n=$(sqlq "select (select count(*) from config where name='tkt-version') + (select count(*) from config where name='ticket-table' and instr(cast(value as text),'blockers TEXT') > 0);" 2>/dev/null) || return 1
  [ "${n:-0}" -gt 0 ]
}

lit() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

need() {
  [ -f "$REPO" ] || die "no tracker at $REPO, run: tkt init"
  # inside a project action's job, say so: the tkt skill sends an agent's results to the ticket when it reads this
  if [ -n "${TKT_JOB:-}" ]; then note "running inside project action ${TKT_ACTION:-?}, job $TKT_JOB"; fi
  local have f
  have=" $(sqlq "select group_concat(name,' ') from pragma_table_info('ticket');") "
  for f in $FIELDS; do
    case "$have" in *" $f "*) ;; *) die "tracker schema predates the $f field, run: tkt init" ;; esac
  done
}

# the canonical ten-char id behind a prefix, failing unless exactly one ticket matches
resolve() {
  local hits
  [ -n "$1" ] || die 'a ticket id is required'
  case "$1" in *[!0123456789abcdef]*) die "not a ticket id: $1" ;; esac
  hits=$(sqlq "select substr(tkt_uuid,1,10) from ticket where tkt_uuid like '$1%';")
  set -- "$1" $hits
  [ $# -eq 2 ] || die "$1 matches no single ticket"
  printf '%s' "$2"
}

# a single dash-word would be taken by fossil as one of its own options
safe() {
  local v
  for v in "$@"; do
    case "$v" in -*[!\ \	]*) case "$v" in *[\ \	]*) ;; *) die "value looks like a fossil option: $v" ;; esac ;; esac
  done
}

# a bracketed hash renders flat under markdown; this is link format 8, where the url becomes the display text
xref() { sed -E 's/\[([0-9a-f]{6,40})\]/[](\1)/g'; }

# piped stdin first, then the editor when the caller allows it, else nothing
slurp() {
  if [ ! -t 0 ]; then
    xref
  elif [ "$1" = editor ] && [ -n "${VISUAL:-${EDITOR:-}}" ]; then
    local tmp ed=${VISUAL:-$EDITOR}
    tmp=$(mktemp)
    sh -c "$ed \"\$1\"" "$ed" "$tmp" </dev/tty >/dev/tty
    xref <"$tmp"
    rm -f "$tmp"
  fi
}

# key=value arguments into kv_<key> vars; an unknown key fails rather than dropping in silence
kv() {
  local known=" $1 " arg k
  shift
  for arg in "$@"; do
    case "$arg" in *=*) ;; *) die "unexpected argument: $arg (expected key=value)" ;; esac
    k=${arg%%=*}
    case "$known" in *" $k "*) ;; *) die "unknown field: $k (known: $(echo $known))" ;; esac
    printf -v "kv_$k" '%s' "${arg#*=}"
  done
}

schema() {
  cat <<'EOF'
CREATE TABLE ticket(
  tkt_id INTEGER PRIMARY KEY,
  tkt_uuid TEXT UNIQUE,
  tkt_mtime DATE,
  tkt_ctime DATE,
  type TEXT,
  status TEXT,
  subsystem TEXT,
  priority TEXT,
  severity TEXT,
  foundin TEXT,
  private_contact TEXT,
  resolution TEXT,
  title TEXT,
  tags TEXT,
  blockers TEXT,
  parent TEXT,
  description TEXT,
  comment TEXT
);
CREATE TABLE ticketchng(
  tkt_id INTEGER REFERENCES ticket,
  tkt_rid INTEGER REFERENCES blob,
  tkt_mtime DATE,
  login TEXT,
  username TEXT,
  mimetype TEXT,
  icomment TEXT
);
CREATE INDEX ticketchng_idx1 ON ticketchng(tkt_id, tkt_mtime);
EOF
}

