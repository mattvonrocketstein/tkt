view() {
  cat <<'EOF'
<th1>
html "<h2 id=\"ticket-title\">[htmlize $title]</h2>\n"
</th1>
<th1>
# each row shows only when it has a value, so a sparse ticket stays short
proc row {label value} {
  if {[string length [string trim $value]] > 0} {
    html "<tr><td class=\"tktDspLabel\">$label:</td><td class=\"tktDspValue\">$value</td></tr>\n"
  }
}
proc field {name} {
  upvar 1 $name v
  if {[info exists v]} { return [string trim $v] }
  return ""
}
# tabler icons: one beside the ticket id copies it, and a row in the details card's footer moves around the ticket's relations
set svg {<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"}
set clip {<path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"/>}
# a card's label row, with collapse and copy controls floated right; the copy takes the markdown source, kept hidden in the card,
# or with no source, the card's text as shown
proc card_head {label src {extra ""}} {
  upvar #0 svg svg clip clip
  html "<div class=\"tkt-card-label\">$label<span class=\"tkt-card-ctl\">$extra"
  html "<a href=\"#\" class=\"tkt-fold\" aria-label=\"Collapse\">$svg class=\"tkt-fold-up\"><path d=\"M6 15l6 -6l6 6\"/></svg>$svg class=\"tkt-fold-down\"><path d=\"M6 9l6 6l6 -6\"/></svg></a>"
  html "<a href=\"#\" class=\"tkt-copy\" aria-label=\"Copy contents\">$svg class=\"tkt-clip\">$clip</svg>$svg class=\"tkt-clipped\">$clip<path d=\"M9 14l2 2l4 -4\"/></svg></a>"
  html "</span></div>\n"
  if {[string length $src] > 0} { html "<pre hidden class=\"tkt-card-src\">[htmlize $src]</pre>\n" }
}
set tid [string range $tkt_uuid 0 9]
# the details card's label carries the ticket's relation icons ahead of its own controls: for a subtask, along its
# siblings and up to its parent; similar tickets by tag; attach; history
set nav ""
set pid ""
query {SELECT substr(p.tkt_uuid,1,10) AS pid FROM ticket t JOIN ticket p ON substr(p.tkt_uuid,1,10)=trim(t.parent) WHERE t.tkt_id=$tkt_id} {}
if {[string length $pid] > 0} {
  set prev ""
  set next ""
  query {SELECT substr(s.tkt_uuid,1,10) AS prev FROM ticket t JOIN ticket s ON trim(s.parent)=trim(t.parent) WHERE t.tkt_id=$tkt_id AND (s.tkt_ctime < t.tkt_ctime OR (s.tkt_ctime = t.tkt_ctime AND s.tkt_id < t.tkt_id)) ORDER BY s.tkt_ctime DESC, s.tkt_id DESC LIMIT 1} {}
  query {SELECT substr(s.tkt_uuid,1,10) AS next FROM ticket t JOIN ticket s ON trim(s.parent)=trim(t.parent) WHERE t.tkt_id=$tkt_id AND (s.tkt_ctime > t.tkt_ctime OR (s.tkt_ctime = t.tkt_ctime AND s.tkt_id > t.tkt_id)) ORDER BY s.tkt_ctime, s.tkt_id LIMIT 1} {}
  set left "$svg><path d=\"M11 17h6l-4 -5l4 -5h-6l-4 5z\"/></svg>"
  set right "$svg><path d=\"M13 7h-6l4 5l-4 5h6l4 -5z\"/></svg>"
  if {[string length $prev] > 0} {
    set nav "$nav<a href=\"$home/tktview/$prev\" aria-label=\"Prev in Series\">$left</a>"
  } else {
    set nav "$nav<span class=\"tkt-off\" aria-label=\"First in Series\">$left</span>"
  }
  if {[string length $next] > 0} {
    set nav "$nav<a href=\"$home/tktview/$next\" aria-label=\"Next in Series\">$right</a>"
  } else {
    set nav "$nav<span class=\"tkt-off\" aria-label=\"Last in Series\">$right</span>"
  }
  set nav "$nav<a href=\"$home/tktview/$pid\" aria-label=\"Up to parent\">$svg><path d=\"M17 11v6l-5 -4l-5 4v-6l5 -4z\"/></svg></a>"
}
set tg [string trim [field tags]]
if {[string length $tg] > 0} {
  set nav "$nav<a href=\"$home/rptview?title=Tagged+Tickets#tags=[httpize $tg]\" aria-label=\"Similar tickets\">$svg><path d=\"M3 8v4.172a2 2 0 0 0 .586 1.414l5.71 5.71a2.41 2.41 0 0 0 3.408 0l3.592 -3.592a2.41 2.41 0 0 0 0 -3.408l-5.71 -5.71a2 2 0 0 0 -1.414 -.586h-4.172a2 2 0 0 0 -2 2z\"/><path d=\"M18 19l1.592 -1.592a4.82 4.82 0 0 0 0 -6.816l-4.592 -4.592\"/><path d=\"M7 10h-.01\"/></svg></a>"
}
if {[anycap b]} {
  set nav "$nav<a href=\"$home/attachadd?tkt=$tid&amp;from=[httpize /tktview/$tid]\" aria-label=\"Manage Attachments\">$svg><path d=\"M15 7l-6.5 6.5a1.5 1.5 0 0 0 3 3l6.5 -6.5a3 3 0 0 0 -6 -6l-6.5 6.5a4.5 4.5 0 0 0 9 9l6.5 -6.5\"/></svg></a>"
}
set nav "$nav<a href=\"$home/tkthistory/$tid\" aria-label=\"History\">$svg><path d=\"M12 8l0 4l2 2\"/><path d=\"M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5\"/></svg></a><span class=\"tkt-ctl-sep\"></span>"
html "<div class=\"tkt-card tkt-card-fields\">"
card_head Details "" $nav
html "<div class=\"tkt-card-body\"><table class=\"label-value\">\n"
# one related ticket per line, as in blocked by and subtasks: its linked title after a small status mark, a check when
# closed, an x when open, a question mark for anything else. the status itself is the mark's hover hint
proc tktline {id status title} {
  upvar #0 svg svg home home
  if {$status eq "Closed"} {
    set mark {<path d="M5 12l5 5l10 -10"/>}
  } elseif {$status eq "Open"} {
    set mark {<path d="M18 6l-12 12"/><path d="M6 6l12 12"/>}
  } else {
    set mark {<path d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"/><path d="M12 19l0 .01"/>}
  }
  return "<div class=\"tkt-subtask\"><span class=\"tkt-mark\" aria-label=\"[htmlize $status]\">$svg>$mark</svg></span><a class=\"tkt-tktitle\" href=\"$home/tktview/$id\">[htmlize $title]</a></div>\n"
}
# a value with a small copy icon after it; the icon copies $copy, which may differ from what is shown
proc copyable {shown copy label} {
  upvar #0 svg svg clip clip
  return "$shown<a href=\"#\" class=\"tkt-copy tkt-inlineicon\" data-id=\"[htmlize $copy]\" aria-label=\"$label\">$svg class=\"tkt-clip\">$clip</svg>$svg class=\"tkt-clipped\">$clip<path d=\"M9 14l2 2l4 -4\"/></svg></a>"
}
row Ticket [copyable [htmlize $tkt_uuid] $tid "Copy ticket id"]
set v ""
# each part links to the By State report, filtered to that value
foreach f {status type severity} {
  set x [field $f]
  if {[string length $x] > 0} {
    if {[string length $v] > 0} { set v "$v &middot; " }
    set v "$v<a href=\"$home/rptview?title=By+State#$f=[httpize $x]\">[htmlize $x]</a>"
  }
}
row State $v
set x [field subsystem]
if {[string length $x] > 0} { row Subsystem "<a href=\"$home/rptview?title=By+State#subsystem=[httpize $x]\">[htmlize $x]</a>" }
set v ""
foreach t [field tags] {
  set v "$v<a href=\"$home/rptview?title=By+Tag#tag=[httpize $t]\">[htmlize $t]</a> "
}
row Tags $v
set v ""
foreach b [field blockers] {
  query {SELECT substr(tkt_uuid,1,10) AS bid, status AS bstatus, title AS btitle FROM ticket WHERE tkt_uuid LIKE $b || '%'} {
    set v "$v[tktline $bid $bstatus $btitle]"
  }
}
row "Blocked by" $v
set v ""
query {SELECT substr(p.tkt_uuid,1,10) AS pid, p.title AS ptitle FROM ticket t JOIN ticket p ON substr(p.tkt_uuid,1,10)=trim(t.parent) WHERE t.tkt_id=$tkt_id} {
  set v "<a class=\"tkt-tktitle\" href=\"$home/tktview/$pid\">[htmlize $ptitle]</a>"
}
row Parent $v
set v ""
query {SELECT substr(c.tkt_uuid,1,10) AS cid, c.status AS cstatus, c.title AS ctitle FROM ticket t JOIN ticket c ON trim(c.parent)=substr(t.tkt_uuid,1,10) WHERE t.tkt_id=$tkt_id ORDER BY c.tkt_ctime} {
  set v "$v[tktline $cid $cstatus $ctitle]"
}
row Subtasks $v
set fi [field foundin]
if {[string length $fi] > 0} { row "Found in" [copyable [htmlize $fi] $fi "Copy commit"] }
if {[field status] eq "Closed"} { row Resolution [htmlize [field resolution]] }
html "</table></div>\n"
# the card's footer holds its action buttons, on the right. it sits outside the body, so it stays out of a copy;
# collapsing hides it with the body
html "<div class=\"tkt-card-foot\">"
html "<span class=\"tktActions\">"
if {$status eq "Closed"} {
  html "<a class=\"button\" href=\"$home/tktedit/$tkt_uuid?status=Open&amp;resolution=Open\">Reopen</a>"
} else {
  html "<a class=\"button\" href=\"$home/tktedit/$tkt_uuid?status=Closed&amp;resolution=Fixed\">Close</a>"
}
html " <a class=\"button\" href=\"$home/tktedit/$tkt_uuid\">Edit or comment</a></span></div></div>\n"
if {[info exists description] && [string length $description] > 0} {
  html "<div class=\"tkt-card tkt-card-desc\">"
  card_head Description $description
  html "<div class=\"tkt-card-body\">\n"
  # th1 markdown returns {title body} and strips a leading heading into the title; the comment keeps it in the body
  html [lindex [markdown "<!-- -->\n\n$description"] 1]
  html "</div></div>\n"
}
query {SELECT datetime(tkt_mtime) AS xdate, coalesce(login,'') AS xwho,
              coalesce(icomment,'') AS xcmt
         FROM ticketchng
        WHERE tkt_id=$tkt_id AND length(coalesce(icomment,'')) > 0
        ORDER BY tkt_mtime} {
  # the page script rewrites a data-utc span as '3 days ago', keeping the exact time as its hover hint
  set xmeta "<span class=\"tkt-ago\" data-utc=\"$xdate\" aria-label=\"$xdate UTC\">$xdate</span>"
  if {[string length $xwho] > 0} { set xmeta "[htmlize $xwho] &middot; $xmeta" }
  html "<div class=\"tkt-card tkt-card-comment\">"
  card_head "Comment <span class=\"tkt-card-meta\">$xmeta</span>" $xcmt
  html "<div class=\"tkt-card-body\">\n"
  html [lindex [markdown "<!-- -->\n\n$xcmt"] 1]
  html "</div></div>\n"
}
</th1>
EOF
}

