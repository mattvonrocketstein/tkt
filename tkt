    function show(on){ d.style.display=on?'block':''; b.setAttribute('aria-expanded',on?'true':'false'); }
    b.addEventListener('click',function(e){ e.preventDefault(); show(d.style.display!=='block'); });
    document.addEventListener('click',function(e){ if(!b.contains(e.target)&&!d.contains(e.target)) show(false); });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') show(false); });
  });
})();
</script>
