# the github project behind the tracker's directory, as https://github.com/owner/repo, when origin points there
github_url() {
  local url
  url=$(git -C "$(dirname "$REPO")" remote get-url origin 2>/dev/null) || return 1
  case "$url" in
    git@github.com:*) url=${url#git@github.com:} ;;
    ssh://git@github.com/*) url=${url#ssh://git@github.com/} ;;
    https://github.com/*) url=${url#https://github.com/} ;;
    *) return 1 ;;
  esac
  url=${url%/}; url=${url%.git}
  case "$url" in */*/*|*/|/*|'') return 1 ;; esac
  printf 'https://github.com/%s' "$url"
}

# the default branch as origin knows it, else main
github_branch() {
  local ref
  ref=$(git -C "$(dirname "$REPO")" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null) && [ -n "${ref##*/}" ] && printf '%s' "${ref##*/}" || printf main
}

