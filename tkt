#!/usr/bin/env bash

# tkt: a ticket tracker over fossil, with a mutable description beside an append-only comment log.
set -eo pipefail

TKT_VERSION=0.1.0
FIELDS='tags blockers description'
GUEST=hjr
SKIN=xekri
MENU="Tickets /ticket r {} Light ?skin=default * {} Dark ?skin=$SKIN * {} Skins /skins * {} Admin /setup {a s} desktoponly Logout /logout L desktoponly Login /login !L desktoponly"
COLS="substr(tkt_uuid,1,10) || ' | ' || coalesce(nullif(status,''),'-') || ' | ' || coalesce(nullif(severity,''),'-') || ' | ' || coalesce(nullif(trim(tags),''),'-') || ' | ' || coalesce(nullif(title,''),'(untitled)')"

# color only on a terminal, and never when either no-color variable is set or the terminal is dumb
colorful() { [ -z "${NO_COLOR:-}${NOCOLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t "$1" ]; }
if colorful 2; then E_RED=$'\033[31m' E_DIM=$'\033[2m' E_OFF=$'\033[0m'; fi
if colorful 1; then PAINT=1; fi

die() { printf '%stkt:%s %s\n' "$E_RED" "$E_OFF" "$*" >&2; exit 1; }

note() { printf '%stkt:%s %s\n' "$E_DIM" "$E_OFF" "$*" >&2; }

# on a terminal, highlight ids, status, and severity in rows, and headings in a shown ticket
paint() {
  if [ -z "$PAINT" ]; then cat; return; fi
  local b=$'\033[1m' d=$'\033[2m' r=$'\033[31m' g=$'\033[32m' y=$'\033[33m' c=$'\033[36m' o=$'\033[0m'
  sed -E \
    -e "s/^([0-9a-f]{10}) \\| /${b}\\1${o} | /" \
    -e "s/ \\| Open \\| / | ${g}Open${o} | /" \
    -e "s/ \\| WIP \\| / | ${y}WIP${o} | /" \
    -e "s/ \\| Closed \\| / | ${d}Closed${o} | /" \
    -e "s/ \\| Critical \\| / | ${r}Critical${o} | /" \
    -e "s/^(# .*)$/${b}\\1${o}/" \
    -e "s/^(## .*)$/${c}\\1${o}/" \
    -e "s/^---$/${d}---${o}/"
}

usage() {
  cat <<'EOF'
tkt: a ticket tracker over fossil, with a mutable body.

  tkt init [--adopt]                    create or migrate the tracker
  tkt new title=... [field=value...]    file a ticket, stdin is the description
  tkt show <id>                         one ticket as markdown
  tkt list [status=...] [tag=...]       markdown table, Open and WIP by default
  tkt search <text>                     substring across titles, descriptions, comments
  tkt edit <id>                         replace the description from stdin or $EDITOR
  tkt comment <id>                      add a comment from stdin or $EDITOR
  tkt tag <id> <tag...>|--clear         replace the tag set
  tkt block <id> <id...>|--clear        replace what the ticket waits on
  tkt set <id> <field> [value...]       write one field, value from args or stdin
  tkt close <id> [resolution=...]       close, stdin is the closing comment
  tkt serve [port=...]                  web ui in the foreground, replacing any running one
  tkt stop                              stop the server started by serve
  tkt status                            print the server url and pid, or fail
  tkt sql <query> | --schema            read-only sql, as markdown; stdin works too
  tkt skill [install [--project]]       print or install the Claude Code skill
  tkt run <fossil args...>              any fossil command against the tracker
  tkt help | version

Fields for new: title type status severity priority subsystem tags foundin.
Ids are uuid prefixes.  The tracker is $TKT_DB, else the nearest .tkt.fossil here or
above; init creates one at the git root, or here outside git.
EOF
}

# the nearest tracker at or above here, else a new one at the git root, else here
locate() {
  if [ -n "${TKT_DB:-}" ]; then
    case "$TKT_DB" in /*) REPO=$TKT_DB ;; *) REPO=$PWD/$TKT_DB ;; esac
    return
  fi
  local root=$PWD
  while :; do
    if [ -f "$root/.tkt.fossil" ]; then REPO=$root/.tkt.fossil; return; fi
    [ "$root" != / ] || break
    root=$(dirname "$root")
  done
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
  REPO=$root/.tkt.fossil
  if [ ! -f "$REPO" ] && [ -f "$root/.fossil.db" ] && owned "$root/.fossil.db"; then
    die "found a tracker under the old name $root/.fossil.db; rename it to .tkt.fossil or set TKT_DB"
  fi
}

fx() { fossil "$@" -R "$REPO"; }

sqlq() { { printf '.mode list\n.headers off\n'; printf '%s\n' "$@"; } | fossil sql -R "$REPO"; }

# a tkt tracker carries the version row, or predates it but has the blockers column only this schema adds
owned() {
  local REPO=$1 n
  n=$(sqlq "select (select count(*) from config where name='tkt-version') + (select count(*) from config where name='ticket-table' and instr(cast(value as text),'blockers TEXT') > 0);" 2>/dev/null) || return 1
  [ "${n:-0}" -gt 0 ]
}

lit() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

need() {
  [ -f "$REPO" ] || die "no tracker at $REPO, run: tkt init"
  local have f
  have=" $(sqlq "select group_concat(name,' ') from pragma_table_info('ticket');") "
  for f in $FIELDS; do
    case "$have" in *" $f "*) ;; *) die "tracker schema predates the $f field, run: tkt init" ;; esac
  done
}

# the canonical ten-char id behind a prefix, failing unless exactly one ticket matches
resolve() {
  local hits
  [ -n "$1" ] || die 'a ticket id is required'
  case "$1" in *[!0123456789abcdef]*) die "not a ticket id: $1" ;; esac
  hits=$(sqlq "select substr(tkt_uuid,1,10) from ticket where tkt_uuid like '$1%';")
  set -- "$1" $hits
  [ $# -eq 2 ] || die "$1 matches no single ticket"
  printf '%s' "$2"
}

# a single dash-word would be taken by fossil as one of its own options
safe() {
  local v
  for v in "$@"; do
    case "$v" in -*[!\ \	]*) case "$v" in *[\ \	]*) ;; *) die "value looks like a fossil option: $v" ;; esac ;; esac
  done
}

# a bracketed hash renders flat under markdown; this is link format 8, where the url becomes the display text
xref() { sed -E 's/\[([0-9a-f]{6,40})\]/[](\1)/g'; }

# piped stdin first, then the editor when the caller allows it, else nothing
slurp() {
  if [ ! -t 0 ]; then
    xref
  elif [ "$1" = editor ] && [ -n "${VISUAL:-${EDITOR:-}}" ]; then
    local tmp ed=${VISUAL:-$EDITOR}
    tmp=$(mktemp)
    sh -c "$ed \"\$1\"" "$ed" "$tmp" </dev/tty >/dev/tty
    xref <"$tmp"
    rm -f "$tmp"
  fi
}

# key=value arguments into kv_<key> vars; an unknown key fails rather than dropping in silence
kv() {
  local known=" $1 " arg k
  shift
  for arg in "$@"; do
    case "$arg" in *=*) ;; *) die "unexpected argument: $arg (expected key=value)" ;; esac
    k=${arg%%=*}
    case "$known" in *" $k "*) ;; *) die "unknown field: $k (known: $(echo $known))" ;; esac
    printf -v "kv_$k" '%s' "${arg#*=}"
  done
}

schema() {
  cat <<'EOF'
CREATE TABLE ticket(
  tkt_id INTEGER PRIMARY KEY,
  tkt_uuid TEXT UNIQUE,
  tkt_mtime DATE,
  tkt_ctime DATE,
  type TEXT,
  status TEXT,
  subsystem TEXT,
  priority TEXT,
  severity TEXT,
  foundin TEXT,
  private_contact TEXT,
  resolution TEXT,
  title TEXT,
  tags TEXT,
  blockers TEXT,
  description TEXT,
  comment TEXT
);
CREATE TABLE ticketchng(
  tkt_id INTEGER REFERENCES ticket,
  tkt_rid INTEGER REFERENCES blob,
  tkt_mtime DATE,
  login TEXT,
  username TEXT,
  mimetype TEXT,
  icomment TEXT
);
CREATE INDEX ticketchng_idx1 ON ticketchng(tkt_id, tkt_mtime);
EOF
}

view() {
  cat <<'EOF'
<th1>
html "<h2>[htmlize $title]</h2>\n"
</th1>
<table class="label-value">
<tr><td class="tktDspLabel">Ticket:</td><td class="tktDspValue">$<tkt_uuid></td></tr>
<tr><td class="tktDspLabel">State:</td><td class="tktDspValue">$<status> &middot; $<type> &middot; $<severity></td></tr>
<tr><td class="tktDspLabel">Subsystem:</td><td class="tktDspValue">$<subsystem></td></tr>
<tr><td class="tktDspLabel">Tags:</td><td class="tktDspValue">$<tags></td></tr>
<tr><td class="tktDspLabel">Blocked by:</td><td class="tktDspValue">$<blockers></td></tr>
<tr><td class="tktDspLabel">Found in:</td><td class="tktDspValue">$<foundin></td></tr>
<tr><td class="tktDspLabel">Resolution:</td><td class="tktDspValue">$<resolution></td></tr>
</table>
<th1>
html "<p class=\"tktActions\">"
if {$status eq "Closed"} {
  html "<a class=\"button\" href=\"$home/tktedit/$tkt_uuid?status=Open&amp;resolution=Open\">Reopen</a>"
} else {
  html "<a class=\"button\" href=\"$home/tktedit/$tkt_uuid?status=Closed&amp;resolution=Fixed\">Close</a>"
}
html " <a class=\"button\" href=\"$home/tktedit/$tkt_uuid\">Edit or comment</a></p>\n"
if {[info exists description] && [string length $description] > 0} {
  html "<div class=\"section\">Description</div>\n"
  html "<div class=\"tktDspValue\">\n"
